import './zmodel/abstract.zmodel'
import './zmodel/auth.zmodel'
import './zmodel/person.zmodel'
import './zmodel/document.zmodel'
import './zmodel/form.zmodel'
import './zmodel/messenger.zmodel'
import './zmodel/request.zmodel'

plugin trpc {
  provider = '@zenstackhq/trpc'
  output = './src/server/api'
  version = 'v11'
  importCreateRouter = "../../trpc"
  importProcedure = "../../trpc"
}

plugin hooks {
  provider = '@zenstackhq/tanstack-query'
  target = 'react'
  version = 'v5'
  output = "./src/services/api/hooks"
  operations = ["get"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant extends Auditable {
  id               String     @id @default(uuid()) @db.UniqueIdentifier
  name             String
  logoUrl          String?
  websiteUrl       String?
  title            String?
  description      String?
  primaryColor     String?
  secondaryColor   String?
  contactEmail     String?
  contactPhone     String?
  address          String?

  // Related entities
  persons          Person[]
  clients          Client[]
  requirements              Requirement[]
  categoryRequirements      CategoryRequirement[]
  salesChannels             SalesChannel[]
  serviceTypes              ServiceType[]
  requirementServiceTypeAssociations RequirementServiceTypeAssociation[]
  requests                  Request[]
  requirementComplianceTrackings RequirementComplianceTracking[]
  documents                 Document[]
  areas                     Area[]
  categories                Category[]
  subCategories             SubCategory[]
  requestAssignments        RequestAssignment[]
  userRoles                 UserRole[]
  roles                     Role[]
  modules                   Module[]
  permissions               Permission[]
  rolePermissions           RolePermission[]
  requestStates             RequestState[]
  identificationTypes       IdentificationType[]
  documentAssignments       DocumentAssignment[]
  requestTypes              RequestType[]
  forms                     Form[]
  formSubmission            FormSubmission[]
  workspaces                Workspace[]
  members                   Member[]
  channels                  Channel[]
  conversations             Conversation[]
  messages                  Message[]
  reactions                 Reaction[]

  userTenants      UserTenant[] // Relation to UserTenant

  @@map("Tenants")
}
