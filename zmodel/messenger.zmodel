import "./abstract.zmodel"
import "./auth.zmodel"

// Workspace model
model Workspace extends TenantScoped {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  name      String
  joinCode  String
  userId    String   @db.UniqueIdentifier
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  members   Member[]
  channels  Channel[]
  messages  Message[]
  reactions Reaction[]

  @@index([userId])

  conversation Conversation[]
}

// Member model
model Member extends TenantScoped {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  userId       String    @db.UniqueIdentifier
  workspaceId  String    @db.UniqueIdentifier
  role         String    @db.VarChar(20) // e.g., "admin", "member"
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reactions    Reaction[]
  messages     Message[]

  conversationsAsMemberOne Conversation[] @relation("MemberOne")
  conversationsAsMemberTwo Conversation[] @relation("MemberTwo")

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, userId])
}

// Channel model
model Channel extends TenantScoped {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  name         String
  workspaceId  String    @db.UniqueIdentifier
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction)

  messages     Message[] // Link messages to the channel

  @@index([workspaceId])
}

// Conversation model
model Conversation extends TenantScoped {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  workspaceId   String    @db.UniqueIdentifier
  memberOneId   String    @db.UniqueIdentifier
  memberTwoId   String    @db.UniqueIdentifier
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberOne     Member    @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberTwo     Member    @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  messages      Message[] // Link messages to the conversation

  @@index([workspaceId])
}

// Message model
model Message extends TenantScoped {
  id               String       @id @default(uuid()) @db.UniqueIdentifier
  body             String
  imageId          String?      @db.UniqueIdentifier // Optional image relation
  memberId         String       @db.UniqueIdentifier
  workspaceId      String       @db.UniqueIdentifier
  channelId        String?      @db.UniqueIdentifier
  parentMessageId  String?      @db.UniqueIdentifier
  conversationId   String?      @db.UniqueIdentifier
  updatedAt        DateTime?    @updatedAt

  member           Member       @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel          Channel?     @relation(fields: [channelId], references: [id], onDelete: NoAction)
  parentMessage    Message?     @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies          Message[]    @relation("ParentMessage") // Opposite relation for replies
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions        Reaction[]   // Link reactions to messages

  @@index([workspaceId])
  @@index([memberId])
  @@index([channelId])
  @@index([parentMessageId])
  @@index([conversationId])
  @@index([channelId, parentMessageId, conversationId])
}

// Reaction model
model Reaction extends TenantScoped {
  id           String     @id @default(uuid()) @db.UniqueIdentifier
  workspaceId  String     @db.UniqueIdentifier
  messageId    String     @db.UniqueIdentifier
  memberId     String     @db.UniqueIdentifier
  value        String

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message      Message     @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member       Member      @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId])
  @@index([messageId])
  @@index([memberId])
}
