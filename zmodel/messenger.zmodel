import "./abstract.zmodel"
import "./auth.zmodel"
import './tenant.zmodel'
import './request.zmodel'

model Notification extends TenantScoped {
  id          String     @id @default(uuid()) //@db.UniqueIdentifier
  type        String
  body        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  recipients  NotificationRecipient[]
}

model NotificationRecipient extends TenantScoped {
  id              String     @id @default(uuid())
  notification    Notification @relation(fields: [notificationId], references: [id])
  notificationId  String
  userTenant      UserTenant   @relation(fields: [userTenantId], references: [id])
  userTenantId    String
  readAt          DateTime?
  
  @@unique([notificationId, userTenantId])
  @@index([userTenantId])
}

model Channel extends TenantScoped, Auditable {
  id        String    @id @default(uuid()) //@db.UniqueIdentifier
  name      String
  messages  Message[]

  requestId String?   @unique //@db.UniqueIdentifier
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@unique([requestId, tenantId])
}

model Conversation extends TenantScoped {
  id              String     @id @default(uuid()) //@db.UniqueIdentifier
  userTenantOneId String
  userTenantTwoId String
  userTenantOne   UserTenant @relation("UserTenantOne", fields: [userTenantOneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenantTwo   UserTenant @relation("UserTenantTwo", fields: [userTenantTwoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        Message[]

  @@index([userTenantOneId, userTenantTwoId])
  @@unique([userTenantOneId, userTenantTwoId])
}

model Message extends TenantScoped, Auditable {
  id              String        @id @default(uuid()) //@db.UniqueIdentifier
  body            String
  imageId         String?
  userTenantId    String
  channelId       String?       //@db.UniqueIdentifier
  parentMessageId String?       //@db.UniqueIdentifier
  conversationId  String?       //@db.UniqueIdentifier
  userTenant      UserTenant    @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel         Channel?      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  parentMessage   Message?      @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]     @relation("ParentMessage")
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions       Reaction[]

  @@index([userTenantId])
  @@index([channelId])
  @@index([parentMessageId])
  @@index([conversationId])
}

model Reaction extends TenantScoped {
  id           String     @id @default(uuid()) //@db.UniqueIdentifier
  value        String
  messageId    String     //@db.UniqueIdentifier
  userTenantId String
  message      Message    @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([messageId])
  @@index([userTenantId])
  @@unique([messageId, userTenantId])
}
