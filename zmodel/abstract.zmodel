import './tenant.zmodel'

abstract model TenantScoped {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Relation to Tenant entity

  // Allow read access for authenticated users in the tenant if:
  // 1. Their userTenant is active and current
  // 2. The tenantId matches the activeTenantId in their session
  //    (tenant.activeSessions contains a session for this user, meaning activeTenantId == tenantId)
  // Note: This requires that activeTenantId is set in the session before accessing tenant resources.
  // The proxy.ts and layout.tsx ensure activeTenantId is set before any queries are executed.
  @@allow('read', 
    tenant.userTenants?[user.id == auth().id && isActive == true] &&
    tenant.activeSessions?[user.id == auth().id]
  )
  
  // Allow create access for authenticated users in the tenant if:
  // 1. Their userTenant is active and current
  // 2. The tenantId matches the activeTenantId in their session
  @@allow('create', 
    tenant.userTenants?[user.id == auth().id && isActive == true] &&
    tenant.activeSessions?[user.id == auth().id]
  ) 
  
  // Allow update access for authenticated users in the tenant if:
  // 1. Their userTenant is active and current
  // 2. The tenantId matches the activeTenantId in their session
  @@allow('update', 
    tenant.userTenants?[user.id == auth().id && isActive == true] &&
    tenant.activeSessions?[user.id == auth().id]
  ) 
  
  // Allow delete access for authenticated users in the tenant if:
  // 1. Their userTenant is active and current
  // 2. The tenantId matches the activeTenantId in their session
  @@allow('delete', 
    tenant.userTenants?[user.id == auth().id && isActive == true] &&
    tenant.activeSessions?[user.id == auth().id]
  )
}

// Abstract model for auditable entities
abstract model Auditable {
  // Timestamps
  createdAt  DateTime  @default(now()) // Timestamp when the entity was created
  updatedAt  DateTime? @updatedAt // Timestamp when the entity was last updated
  deletedAt  DateTime? // Timestamp when the entity was deleted (soft delete)

  // User tracking
  createdBy  String?   @db.VarChar(50) @default(auth().id) // ID of the user who created the entity
  updatedBy String?   @db.VarChar(50) @default(auth().id) // ID of the user who last modified the entity
}

/// Abstract model for base catalog fields.
abstract model CatalogBase {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100) // Name of the catalog item
  description String? @db.VarChar(255) // Optional description
  isActive    Boolean @default(true)
}