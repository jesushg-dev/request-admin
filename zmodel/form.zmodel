import './abstract.zmodel'
import './request.zmodel'
import './tenant.zmodel'
import './category.zmodel'

model Form extends TenantScoped, Auditable, CatalogBase {
  // Form details
  userId          String     @db.UniqueIdentifier // ID of the user who owns the form
  content         String     @default("[]") @db.NVarChar(Max) // Structure of the form in JSON format
  published       Boolean    @default(false) // Publication status of the form

  // Form statistics
  visits          Int        @default(0) // Number of visits to the form
  submissions     Int        @default(0) // Number of submissions received
  shareURL        String     @unique @default(uuid()) // Unique shareable URL

  // Relationships
  categoryForms   CategoryForm[] // Links the form to multiple categories
  formSubmissions     FormSubmission[] // Submissions made to this form

  // Constraints
  @@unique([name, tenantId])
}

model CategoryForm extends TenantScoped, Auditable {
  // Primary identifier
  id              String     @id @default(uuid()) @db.UniqueIdentifier

  // Relationships
  categoryId      String     @db.UniqueIdentifier // ID of the associated category
  formId          String     @db.UniqueIdentifier // ID of the associated form

  requestCategories  RequestCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  form            Form       @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Constraints
  @@unique([categoryId, formId]) // Ensures no duplicate links between the same category and form
}

model FormSubmission extends TenantScoped, Auditable {
  // Primary identifier
  id              String     @id @default(uuid()) @db.UniqueIdentifier

  // Submission details
  formId          String     @db.UniqueIdentifier // ID of the associated form
  content         String     // Submitted content in JSON format

  // Key-Value desnormalized data for quick access
  keys            FormSubmissionKey[] // Key-value pairs for reusable fields

  // Relationships
  form            Form       @relation(fields: [formId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Link to the associated form
  
  requestId      String?     @db.UniqueIdentifier // ID of the associated request
  request        Request?    @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Link to the associated request

  // Index for faster queries
  @@index([formId])

}

model FormSubmissionKey extends TenantScoped, Auditable {
  // Primary identifier
  id              String     @id @default(uuid()) @db.UniqueIdentifier

  // Key-value pair details
  submissionId    String     @db.UniqueIdentifier // ID of the associated submission
  key             String     @db.VarChar(255)     // Name of the key
  value           String     @db.VarChar(255)     // Value of the key

  // Relationships
  submission      FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Link to the associated submission

  // Index for faster queries
  @@index([key, value])
}
