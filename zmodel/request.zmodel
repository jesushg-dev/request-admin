import './abstract.zmodel'
import './auth.zmodel'  // user and role management
import './document.zmodel' // files and attachments for requests
import './area.zmodel' // areas for request assignment
import './form.zmodel' // form submissions for requests
import './category.zmodel' // categorization for requests
import './messenger.zmodel' // messaging for requests

/// Represents a request that includes categorization for both request and assignment.
model Request extends TenantScoped, Auditable {
  // Primary identifier
  id                   String                          @id @default(uuid()) @db.UniqueIdentifier // Request ID

  // Request details
  issueSubject         String?                         @db.VarChar(255)    // Optional issue subject
  description          String?                         @db.VarChar(5000)   // Detailed request description
  closedAt             DateTime?
  closedBy             String?                         @db.VarChar(50)     // User ID who closed the request
  closedComment        String?                         @db.VarChar(500)    // Closure comment
  comment              String?                         @db.VarChar(255)    // Optional comment

  // Related documents
  documents            Document[]

  // Form submissions
  formSubmission       FormSubmission[]

  // Compliance tracking
  complianceTrackings  RequirementComplianceTracking[]

  // Assignments
  requestAssignments   RequestAssignment[]

  // Related incidents
  relatedIncidents     RelatedIncident[]               @relation("RequestIncident")
  relatedTo            RelatedIncident[]               @relation("RequestRelated")

  // Change log
  changeLog            RequestChangeLog[]

  // Satisfaction survey
  satisfactionSurveyId String?                         @db.UniqueIdentifier
  satisfactionSurvey   CustomerSatisfactionSurvey?     @relation("RequestSurvey")

  // Channel
  channelId            String?                         @db.UniqueIdentifier
  channel              Channel?

  @@index([closedAt], name: "idx_request_closed_at")
  @@index([closedBy], name: "idx_request_closed_by")
  @@index([closedComment], name: "idx_request_closed_comment")
  @@index([issueSubject], name: "idx_request_issue_subject")
}

/// Represents related incidents or problems for a request.
model RelatedIncident extends TenantScoped, Auditable {
  id        String  @id @default(uuid()) @db.UniqueIdentifier
  requestId String  @db.UniqueIdentifier
  relatedId String  @db.UniqueIdentifier

  request   Request @relation("RequestIncident", fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  related   Request @relation("RequestRelated", fields: [relatedId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestId], name: "idx_related_incident_request_id")
  @@index([relatedId], name: "idx_related_incident_related_id")
}

/// Represents an assignment of a request to users or areas.
model RequestAssignment extends TenantScoped, Auditable {
  id                   String               @id @default(uuid()) @db.UniqueIdentifier
  comment              String?              @db.VarChar(255)
  assignmentDate       DateTime
  unAssignmentDate     DateTime?
  requestId            String               @db.UniqueIdentifier
  request              Request              @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  areaId               String?              @db.UniqueIdentifier
  area                 Area?                @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  statusId             String               @db.UniqueIdentifier
  status               RequestStatusType    @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  typeId               String               @db.UniqueIdentifier
  type                 AssignmentType       @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  priorityId           String              @db.UniqueIdentifier
  priority             RequestPriorityType @relation(fields: [priorityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assignedUsers        AssignedUser[]       @relation("AssignedUsers")

  documentAssignment   DocumentAssignment[]

  // SLA
  slaStart             DateTime?
  slaDeadline          DateTime?
  slaEnd               DateTime?

  // Request categorization
  requestCategoryId    String               @db.UniqueIdentifier
  requestCategory      RequestCategory      @relation("RequestCategory", fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Assignment categorization
  assignmentCategoryId String               @db.UniqueIdentifier
  assignmentCategory   AssignmentCategory   @relation("AssignmentCategory", fields: [assignmentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([typeId], name: "idx_assignment_type_id")
  @@index([requestId], name: "idx_assignment_request_id")
  @@index([statusId], name: "idx_assignment_status_id")
  @@index([slaStart], name: "idx_assignment_sla_start")
  @@index([slaDeadline], name: "idx_assignment_sla_deadline")
  @@index([slaEnd], name: "idx_assignment_sla_end")
  @@index([requestCategoryId], name: "idx_assignment_request_category_id")
  @@index([assignmentCategoryId], name: "idx_assignment_assignment_category_id")
}

/// Represents the users assigned to a request, including the coordinator.
model AssignedUser extends TenantScoped, Auditable {
  id                  String            @id @default(uuid()) @db.UniqueIdentifier
  requestAssignment   RequestAssignment @relation("AssignedUsers", fields: [requestAssignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requestAssignmentId String            @db.UniqueIdentifier

  userTenantId        String            @db.UniqueIdentifier
  userTenant          UserTenant        @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  role                String            @db.VarChar(150) // Role of the user in the request (e.g., Coordinator, Collaborator)
  isCoordinator       Boolean           @default(false) // Indicates if the user is the coordinator
  unAssignmentDate    DateTime?
}

// Represents a type of assignment for requests.
model AssignmentType extends  TenantScoped, Auditable, CatalogBase {
  assignments RequestAssignment[]
  @@unique([name, tenantId])
}

/// Represents a catalog of possible priority levels for requests or assignments.
model RequestPriorityType extends TenantScoped, Auditable, CatalogBase {
  assignments RequestAssignment[]
  @@unique([name, tenantId])
}

/// Represents a catalog of possible statuses for requests or assignments.
model RequestStatusType extends TenantScoped, Auditable {
  id                  String                    @id @default(uuid()) @db.UniqueIdentifier
  name                String                    @db.VarChar(50) @unique
  description         String?                   @db.VarChar(255)
  isActive            Boolean                   @default(true)
  isAllowedToChangeCategory Boolean             @default(true) // Defines if categories can be changed for this status

  assignments         RequestAssignment[]

  fromTransitions     RequestStatusTransition[] @relation("FromStatus")
  toTransitions       RequestStatusTransition[] @relation("ToStatus")
}

/// Manages valid transitions between statuses and can track SLA details.
model RequestStatusTransition extends TenantScoped, Auditable {
  id           String            @id @default(uuid()) @db.UniqueIdentifier
  reason       String?
  startedAt    DateTime?
  finishedAt   DateTime?
  deadline     DateTime?

  fromStatusId String            @db.UniqueIdentifier
  toStatusId   String            @db.UniqueIdentifier

  fromStatus   RequestStatusType @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toStatus     RequestStatusType @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)


  isDefault    Boolean           @default(false)

  @@index([fromStatusId], name: "idx_transition_from_status_id")
  @@index([toStatusId], name: "idx_transition_to_status_id")
}

/// Tracks compliance with requirements for a specific request.
model RequirementComplianceTracking extends TenantScoped, Auditable {
  id            String      @id @default(uuid()) @db.UniqueIdentifier
  requestId     String      @db.UniqueIdentifier
  request       Request     @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirementId String      @db.UniqueIdentifier
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isFulfilled   Boolean     @default(false)
  isArchived    Boolean     @default(false) // Defines if the tracking is archived because the requirement is no longer relevant

  document      Document[]

  @@index([requestId], name: "idx_compliance_request_id")
  @@index([requirementId], name: "idx_compliance_requirement_id")
}

/// Tracks customer satisfaction surveys for closed requests.
model CustomerSatisfactionSurvey extends TenantScoped, Auditable {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  rating      Int
  feedback    String?  @db.VarChar(1000)
  submittedAt DateTime

  requestId   String   @db.UniqueIdentifier @unique
  request     Request  @relation("RequestSurvey", fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestId], name: "idx_survey_request_id")
}

/// Logs changes to requests for auditing purposes.
model RequestChangeLog extends TenantScoped, Auditable {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  requestId String   @db.UniqueIdentifier
  request   Request  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  changedBy String   @db.UniqueIdentifier
  fieldName String   @db.VarChar(100)
  oldValue  String?  @db.VarChar(500)
  newValue  String?  @db.VarChar(500)
  changedAt DateTime

  @@index([requestId], name: "idx_change_log_request_id")
  @@index([changedBy], name: "idx_change_log_changed_by")
}
