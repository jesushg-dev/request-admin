import './abstract.zmodel'
import './auth.zmodel'
import './form.zmodel'
import './document.zmodel'
import './person.zmodel'

/// Represents a hierarchy for categorization (e.g., "Sales Channel Hierarchy", "Assignment Hierarchy").
model Hierarchy extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique hierarchy ID
  name                  String   @db.VarChar(100) // Name of the hierarchy
  description           String?  @db.VarChar(255) // Optional description
  levels                HierarchyLevel[] // Levels within the hierarchy
  categories            Category[] // Categories directly associated with this hierarchy
}

/// Represents a single level in a hierarchy (e.g., "Area", "Case Type", "Service Type").
model HierarchyLevel extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique level ID
  name                  String   @db.VarChar(100) // Name of the level
  position              Int      // Position of the level within the hierarchy
  hierarchyId           String   @db.UniqueIdentifier() // ID of the associated hierarchy
  hierarchy             Hierarchy @relation(fields: [hierarchyId], references: [id]) // Linked hierarchy
  categories            Category[] // Categories associated with this level
}

/// Represents a category or subcategory within a hierarchy.
model Category extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique category ID
  name                  String   @db.VarChar(100) // Name of the category
  description           String?  @db.VarChar(255) // Optional description
  parentCategoryId      String?  @db.UniqueIdentifier @map("parent_id") // ID of the parent category, if this is a subcategory
  parentCategory        Category? @relation("ParentCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked parent category
  subcategories         Category[] @relation("ParentCategory") // Subcategories under this category
  hierarchyLevelId      String   @db.UniqueIdentifier // ID of the associated hierarchy level
  hierarchyLevel        HierarchyLevel @relation(fields: [hierarchyLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked hierarchy level
  hierarchyId           String   @db.UniqueIdentifier // ID of the associated hierarchy
  hierarchy             Hierarchy @relation(fields: [hierarchyId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked hierarchy
  forms                 Form[] // Forms linked to this category
  areas                 Area[] // Areas linked to this category

  /// Linked service requests
  serviceRequests       Request[] @relation("ServiceCategory") // Requests where this category is the service category

  /// Linked assignment requests
  assignmentRequests    Request[] @relation("AssignmentCategory") // Requests where this category is the assignment category

  categoryRequirement   CategoryRequirement[] // Requirement mappings
}

/// Represents a service request that includes categorization for both service and assignment.
model Request extends TenantScoped, Auditable {
  id                    String              @id @default(uuid()) @db.UniqueIdentifier // Request ID
  clientId              String              @db.UniqueIdentifier // Client ID
  issueSubject          String?             @db.VarChar(255) // Optional issue subject
  description           String?             @db.VarChar(5000) // Detailed request description
  priority              String?             @db.VarChar(50) // Optional priority level
  closedAt              DateTime?           // Closure timestamp
  closedBy              String?             @db.VarChar(50) // User ID who closed the request
  closedComment         String?             @db.VarChar(500) // Closure comment
  status                String              @db.VarChar(50) // Request status
  comment               String?             @db.VarChar(255) // Optional comment

  /// Service categorization (e.g., "Sales Channel > Service Type").
  serviceCategoryId     String              @db.UniqueIdentifier // Service category ID
  serviceCategory       Category            @relation("ServiceCategory", fields: [serviceCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked service category

  /// Assignment categorization (e.g., "Area > Case Type > Category > Subcategory").
  assignmentCategoryId  String              @db.UniqueIdentifier // Assignment category ID
  assignmentCategory    Category            @relation("AssignmentCategory", fields: [assignmentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked assignment category

  client                Client              @relation(fields: [clientId], references: [id]) // Linked client
  formSubmissionId      String?             @db.UniqueIdentifier // Form submission ID
  formSubmission        FormSubmission?     @relation(fields: [formSubmissionId], references: [id]) // Linked form submission
  documents             Document[]          // Linked documents
  requestAssignments    RequestAssignment[] // Linked assignments
  complianceTrackings   RequirementComplianceTracking[] // Compliance tracking
}

/// Represents an assignment of a request to a user or area.
model RequestAssignment extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique assignment ID
  requestId             String   @db.UniqueIdentifier // ID of the associated request
  request               Request  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked request
  userId                String?  @db.UniqueIdentifier // Optional user assigned to the request
  user                  User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked user
  areaId                String?  @db.UniqueIdentifier // Optional area assigned to the request
  area                  Area?    @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked area
  priority              String?  @db.VarChar(50) // Optional priority
  comment               String?  @db.VarChar(255) // Optional comment
  assignmentDate        DateTime // Date of the assignment
  unassignmentDate      DateTime? // Date the assignment was unassigned
  status                String    @db.VarChar(50) // Status of the assignment
  type                  String    @db.VarChar(50) // Type of assignment
  documentAssignment    DocumentAssignment[] // Document assignments related to this request assignment
}

/// Represents an organizational area.
model Area extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique area ID
  name                  String   @db.VarChar(100) @unique // Unique name of the area
  description           String?  @db.VarChar(255) // Optional description
  status                Boolean  @default(true) // Indicates if the area is active
  user                  User[] // Users linked to the area
  requestAssignment     RequestAssignment[] // Request assignments associated with this area
  categories            Category[] // Categories associated with the area
}

/// Represents a specific requirement for a service or category.
model Requirement extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique requirement ID
  name                  String   @db.VarChar(200) @unique // Name of the requirement
  description           String   @db.VarChar(500) // Description of the requirement
  onlyRequireInNewClients Boolean @default(false) // Indicates if the requirement applies only to new clients
  requirementComplianceTracking RequirementComplianceTracking[] // Compliance tracking entries for this requirement
  categoryRequirement CategoryRequirement[] // Associations with service types
}

/// Links a requirement to a specific service type.
model CategoryRequirement extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique association ID
  requirementId         String   @db.UniqueIdentifier // ID of the linked requirement
  requirement           Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked requirement
  categoryId            String   @db.UniqueIdentifier // ID of the linked service type
  category              Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked service type
}

/// Tracks compliance with requirements for a specific request.
model RequirementComplianceTracking extends TenantScoped, Auditable {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier // Unique compliance tracking ID
  requestId             String   @db.UniqueIdentifier // ID of the associated request
  request               Request  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked request
  requirementId         String   @db.UniqueIdentifier // ID of the associated requirement
  requirement           Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked requirement
  fulfilled             Boolean  @default(false) // Whether the requirement is fulfilled
}