import './abstract.zmodel'
import './category.zmodel'
import './request.zmodel'

/// # Workflow Execution System
///
/// ## Core Workflow Definitions
/// @namespace CoreWorkflow
/// @erd CoreWorkflow

/// Represents a versioned workflow template containing nodes and edges
/// 
/// Relationships:
/// ╠═► nodes: Contains all component nodes
/// ╠═► edges: Defines transitions between nodes
/// ╠═► executions: Runtime instances using this template
/// ╚═► requestCategory: Business process classification
model ExecutionFlowDefinition extends TenantScoped, Auditable {
  id                  String                      @id @default(uuid())
  version             Int                         @default(1)
  nodes               ExecutionNodeDefinition[]
  edges               ExecutionEdgeDefinition[]
  isActive            Boolean                     @default(true)
  executions          ExecutionModelInstance[]
  previousHistories   ExecutionModelHistory[]     @relation("PreviousFlowHistory")
  newHistories        ExecutionModelHistory[]     @relation("NewFlowHistory")
  requestCategoryId   String?                     @unique
  requestCategory     RequestCategory?            @relation(fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  viewportX           Float?
  viewportY           Float?
  viewportZoom        Float?

  @@unique([id, version])
  @@index([requestCategoryId])
}

/// Atomic unit in workflow execution path
/// @minItems 1
model ExecutionNodeDefinition extends TenantScoped, Auditable {
  id            String                     @id @default(uuid())
  flow          ExecutionFlowDefinition     @relation(fields: [flowId], references: [id])
  flowId        String
  type          String
  positionX     Float
  positionY     Float
  config        String
  edgesFrom     ExecutionEdgeDefinition[]  @relation("SourceEdges")
  edgesTo       ExecutionEdgeDefinition[]  @relation("TargetEdges")
  executionLogs ExecutionModelLog[]
  nodeGuide     ExecutionNodeGuide[]

  @@index([type])
}

/// Defines transitions between nodes with conditional logic
/// @minItems 1
model ExecutionEdgeDefinition extends TenantScoped, Auditable {
  id           String                    @id @default(uuid())
  flow         ExecutionFlowDefinition @relation(fields: [flowId], references: [id])
  flowId       String
  source       ExecutionNodeDefinition @relation("SourceEdges", fields: [sourceId], references: [id])
  sourceId     String
  target       ExecutionNodeDefinition   @relation("TargetEdges", fields: [targetId], references: [id])
  targetId     String
  sourceHandle String?
  style        String?
  markerEnd    String?

  @@index([sourceId, targetId])
}

/// ## Documentation System
/// @namespace Documentation
/// @erd Documentation

/// Links procedural guides to workflow nodes
model ExecutionNodeGuide extends TenantScoped, Auditable {
  id                  String                   @id @default(uuid())
  applicationScope    String                   @default("full")
  customInstructions  String?
  order               Int                      @default(1)
  guideId             String
  guide               GuideDocument            @relation(fields: [guideId], references: [id])
  nodeId              String
  node                ExecutionNodeDefinition  @relation(fields: [nodeId], references: [id])

  @@unique([guideId, nodeId])
}

/// ## Runtime Execution Tracking
/// @namespace RuntimeExecution
/// @erd RuntimeExecution

/// Concrete instance of workflow execution
model ExecutionModelInstance extends TenantScoped, Auditable {
  id          String                    @id @default(uuid())
  flow        ExecutionFlowDefinition    @relation(fields: [flowId], references: [id])
  flowId      String
  requestId   String   @unique //@db.UniqueIdentifier
  request     Request  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String
  logs        ExecutionModelLog[]
  history     ExecutionModelHistory[]


  @@index([status])
  @@index([tenantId, flowId, requestId])
  @@unique([tenantId, flowId, requestId])
}

/// Immutable execution audit record
/// @minItems 1
model ExecutionModelLog extends TenantScoped, Auditable {
  id          String                     @id @default(uuid())
  executionId String
  execution   ExecutionModelInstance @relation(fields: [executionId], references: [id])
  nodeId      String
  node        ExecutionNodeDefinition    @relation(fields: [nodeId], references: [id])
  timestamp   DateTime                   @default(now())
  eventType   String
  details     String
  outcome     String

  @@index([timestamp])
}

/// ## Version History Tracking
/// @namespace VersionHistory
/// @erd VersionHistory

/// Records workflow template migrations during execution
model ExecutionModelHistory extends TenantScoped, Auditable {
  id             String                     @id @default(uuid())
  executionId    String
  execution      ExecutionModelInstance @relation(fields: [executionId], references: [id])
  previousFlowId String?
  previousFlow   ExecutionFlowDefinition? @relation("PreviousFlowHistory", fields: [previousFlowId], references: [id])
  newFlowId      String
  newFlow        ExecutionFlowDefinition @relation("NewFlowHistory", fields: [newFlowId], references: [id])
  reason         String

  @@index([updatedAt])
}