import './abstract.zmodel'
import './auth.zmodel'
import './person.zmodel'
import './document.zmodel'
import './form.zmodel'
import './messenger.zmodel'
import './request.zmodel'
import './area.zmodel'
import './category.zmodel'
import './permission.zmodel'

model Tenant extends Auditable {
  id                             String       @id
  name                           String   // Tenant name
  slug                           String?
  logo                           String?  // URL for the tenant's logo
  metadata                       String?

  websiteUrl                     String?  // URL for the tenant's website
  title                          String?  // Title or tagline for the tenant
  description                    String?  // Brief description of the tenant
  primaryColor                   String?  // Primary color for branding
  secondaryColor                 String?  // Secondary color for branding
  contactEmail                   String?  // Tenant's contact email
  contactPhone                   String?  // Tenant's contact phone number
  address                        String?  // Address for the tenant

  // --- Hierarchy Management ---
  assignmentHierarchies          AssignmentHierarchy[]
  assignmentHierarchyLevels      AssignmentHierarchyLevel[]
  assignmentCategories           AssignmentCategory[]
  requestHierarchies             RequestHierarchy[]
  requestHierarchyLevels         RequestHierarchyLevel[]
  requestCategories              RequestCategory[] 

  // --- Requirements and Compliance ---
  requirements                   Requirement[]
  requirementTypes               RequirementType[]
  categoryRequirements           RequestCategoryRequirement[] // Updated to match naming convention

  // --- SLA and Guide Documents ---
  slas                           SLA[]
  sLAChangeLogs                  SLAChangeLog[]
  guideDocuments                 GuideDocument[] 

  // --- Requests and Statuses ---
  requests                       Request[]
  requestAssignments             RequestAssignment[]
  assignedUsers                  AssignedUser[]
  requestStatusTypes             RequestStatusType[]
  requestStatusTransitions       RequestStatusTransition[]
  requirementComplianceTrackings RequirementComplianceTracking[]
  relatedIncidents               RelatedIncident[]
  requestChangeLogs              RequestChangeLog[]
  customerSatisfactionSurveys    CustomerSatisfactionSurvey[]
  assignmentTypes                AssignmentType[]
  requestPriorityTypes           RequestPriorityType[]

  // --- Forms ---
  forms                          Form[]
  formSubmissions                FormSubmission[]
  formSubmissionKeys             FormSubmissionKey[]
  categoryForms                  CategoryForm[]
  menuItems                      MenuItem[]

  // --- Areas and Categories ---
  areas                          Area[]
  userAreas                      UserTenantArea[]
  areaRoles                      AreaRole[]
  areaRoleFeatures               AreaRoleFeature[]

  // --- Roles and Permissions ---
  persons                        Person[]
  userRoles                      UserTenantRole[]
  roles                          Role[]
  roleFeatures                   RoleFeature[]

  // --- Modules and Features ---
  modules                        Module[]
  features                       Feature[]

  // --- Identification ---
  identificationTypes            IdentificationType[]

  // --- Communication ---
  channels                       Channel[]
  conversations                  Conversation[]
  messages                       Message[]
  reactions                      Reaction[]

  // --- User and Tenant Relationships ---
  userTenants                    UserTenant[]
  invitations                    InvitationTenant[]

  // --- Subscriptions and Usage ---
  subscriptions                  Subscription[]
  usageTracking                  UsageTracking[]

  // --- Documents and Files models ---
  documents                     Document[]
  documentAssignments           DocumentAssignment[]
  documentPages                 DocumentPage[]
  documentVersions              DocumentVersion[]
  links                         Link[]
  linkPresets                   LinkPreset[]
  domains                       Domain[]
  views                         DocumentView[]
  viewers                       Viewer[]
  documentReactions             DocumentReaction[]
  invitation                    InvitationDocument[]
  sentEmails                    SentEmail[]
  documentConversations         DocumentConversation[]
  folders                       Folder[]
  dataroons                     Dataroom[]
  dataroomDocuments             DataroomDocument[]
  dataroomFolders               DataroomFolder[]
  dataroomBrands                DataroomBrand[]
  documentFeedbaks              DocumentFeedback[]
  feedbackResponses             FeedbackResponse[]
  agreements                    Agreement[]
  agreementResponses            AgreementResponse[]
  viewerGroup                   ViewerGroup[]
  viewerGroupMemberships        ViewerGroupMembership[]
  viewerGroupAccessControls     ViewerGroupAccessControls[]
  incomingWeebhooks             IncomingWebhook[]
  restrictedTokens              RestrictedToken[]
  webhooks                      Webhook[]
  yearInReviews                 YearInReview[]
  customFields                  CustomField[]
  customFieldResponse           CustomFieldResponse[]

  // Access control
  @@unique([slug])
  @@allow("read", userTenants?[user.id == auth().id && isActive == true])
}

model UserTenant extends TenantScoped, Auditable {
  id                           String       @id
  isActive                     Boolean          @default(true) // Indicates if the user is active in the tenant
  isTermAccepted               Boolean          @default(false) // Indicates if the user has accepted the terms of the tenant
  joinedAt                     DateTime         @default(now()) // Timestamp of when the user joined the tenant
  isSuperAdmin                 Boolean          @default(false) // Flag for super admin status
  isTwoFactorRequired          Boolean          @default(false)
  role                         String       // It's a dummy field required for better auth

  userId                       String
  user                         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  personId                     String?          @db.UniqueIdentifier
  person                       Person?

  userAreas                    UserTenantArea[]
  userRoles                    UserTenantRole[]
  assignedUsers                AssignedUser[]
  reactions                    Reaction[]     // Reactions made by the user in the tenant
  messages                     Message[]      // Messages sent by the user
  conversationsAsUserTenantOne Conversation[]   @relation("UserTenantOne") // Conversations where this user is UserTenantOne
  conversationsAsUserTenantTwo Conversation[]   @relation("UserTenantTwo") // Conversations where this user is UserTenantTwo
  
  domains          Domain[]
  documents        Document[]
  conversations    DocumentConversation[]
  restrictedTokens RestrictedToken[]

  @@unique([userId, tenantId]) // Ensure unique user-tenant relationships
  @@index([userId]) // Index for efficient queries by userId
  @@index([tenantId]) // Index for efficient queries by tenantId
}

model InvitationTenant extends TenantScoped, Auditable {
  id             String       @id
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String    
  plan       Plan      @relation(fields: [planId], references: [id])
  planId     String    @db.UniqueIdentifier
  startDate  DateTime
  endDate    DateTime
  status     String           // Replaces ENUM
  isLifetime Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]
}

model Plan {
  id             String         @id @default(uuid()) @db.UniqueIdentifier
  name           String
  description    String
  price          Float
  durationInDays Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  features       PlanFeature[]
  subscriptions  Subscription[]
}

model PlanFeature {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  plan          Plan     @relation(fields: [planId], references: [id])
  planId        String   @db.UniqueIdentifier
  feature       Feature  @relation(fields: [featureId], references: [id])
  featureId     String   @db.UniqueIdentifier
  dailyLimit    Int?
  totalLimit    Int?
  resetInterval String         // Replaces ENUM
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UsageTracking {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String    
  featureName String
  usageCount  Int
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id             String       @id @default(uuid()) @db.UniqueIdentifier
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String       @db.UniqueIdentifier
  amount         Float
  paymentDate    DateTime
  paymentMethod  String
  status         String           // Replaces ENUM
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
