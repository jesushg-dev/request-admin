import './abstract.zmodel'
import './auth.zmodel'
import './person.zmodel'
import './document.zmodel'
import './form.zmodel'
import './messenger.zmodel'
import './request.zmodel'
import './area.zmodel'
import './category.zmodel'

model Tenant extends Auditable {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier // Unique identifier for the tenant
  name               String   // Tenant name
  logoUrl            String?  // URL for the tenant's logo
  websiteUrl         String?  // URL for the tenant's website
  title              String?  // Title or tagline for the tenant
  description        String?  // Brief description of the tenant
  primaryColor       String?  // Primary color for branding
  secondaryColor     String?  // Secondary color for branding
  contactEmail       String?  // Tenant's contact email
  contactPhone       String?  // Tenant's contact phone number
  address            String?  // Address for the tenant

  // --- Hierarchy Management ---
  assignationHierarchies      AssignationHierarchy[] 
  assignationHierarchyLevels  AssignationHierarchyLevel[] 
  assignationCategories       AssignationCategory[] 
  requestHierarchies          RequestHierarchy[] 
  requestHierarchyLevels      RequestHierarchyLevel[] 
  requestCategories           RequestCategory[] 

  // --- Requirements and Compliance ---
  requirements                Requirement[] 
  requirementTypes            RequirementType[] 
  categoryRequirements        RequestCategoryRequirement[] // Updated to match naming convention

  // --- SLA and Guide Documents ---
  slas                        SLA[] 
  guideDocuments              GuideDocument[] 

  // --- Documents ---
  documents                   Document[]
  documentAssignments         DocumentAssignment[]

  // --- Requests and Statuses ---
  requests                    Request[]
  requestAssignments          RequestAssignment[]
  requestStatusTypes          RequestStatusType[]
  requestStatusTransitions    RequestStatusTransition[]
  requirementComplianceTrackings RequirementComplianceTracking[]


  // --- Forms ---
  forms                       Form[]
  formSubmissions             FormSubmission[]
  formSubmissionKeys          FormSubmissionKey[]
  categoryForms               CategoryForm[]

  // --- Areas and Categories ---
  areas                       Area[]
  userAreas                   UserArea[]
  areaRoles                   AreaRole[]
  areaRoleFeatures            AreaRoleFeature[]

  // --- Roles and Permissions ---
  persons            Person[]
  userRoles                   UserRole[]
  roles                       Role[]
  roleFeatures                RoleFeature[]

  // --- Modules and Features ---
  modules                     Module[]
  features                    Feature[]

  // --- Identification ---
  identificationTypes         IdentificationType[]

  // --- Communication ---
  workspaces                  Workspace[]
  members                     Member[]
  channels                    Channel[]
  conversations               Conversation[]
  messages                    Message[]
  reactions                   Reaction[]

  // --- User and Tenant Relationships ---
  userTenants                 UserTenant[]

  // --- Subscriptions and Usage ---
  subscriptions               Subscription[]
  usageTracking               UsageTracking[]

  // Access control
  @@allow("read", userTenants?[user.id == auth().id && isActive == true])
}

model Subscription {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  tenantId    String           @db.UniqueIdentifier 
  plan        Plan             @relation(fields: [planId], references: [id])
  planId      String           @db.UniqueIdentifier
  startDate   DateTime
  endDate     DateTime
  status      String           // Replaces ENUM
  isLifetime  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  payments    Payment[]
}

model Plan {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  name         String
  description  String
  price        Float
  durationInDays Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  features     PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  plan         Plan            @relation(fields: [planId], references: [id])
  planId       String       @db.UniqueIdentifier
  feature      Feature         @relation(fields: [featureId], references: [id])
  featureId    String         @db.UniqueIdentifier
  dailyLimit   Int?
  totalLimit   Int?
  resetInterval String         // Replaces ENUM
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model UsageTracking {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  tenantId     String         @db.UniqueIdentifier
  featureName  String
  usageCount   Int
  lastUsedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Payment {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  subscription Subscription    @relation(fields: [subscriptionId], references: [id])
  subscriptionId String       @db.UniqueIdentifier
  amount       Float
  paymentDate  DateTime
  paymentMethod String
  status       String           // Replaces ENUM
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
