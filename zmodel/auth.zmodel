import './tenant.zmodel'
import './abstract.zmodel'
import './request.zmodel'
import './messenger.zmodel'
import './person.zmodel'

model User extends Auditable {
  id                   String    @id @default(uuid()) @db.UniqueIdentifier
  username             String?   @unique // Unique username for login
  email                String?   @unique // Unique email address
  emailVerified        DateTime? // Timestamp for email verification
  password             String    @password @omit // Hashed password, excluded from client queries
  isTwoFactorEnabled   Boolean   @default(false) // Flag for two-factor authentication
  twoFactorConfirmationId String? @db.UniqueIdentifier // ID for two-factor confirmation
  twoFactorConfirmation TwoFactorConfirmation? // Related two-factor confirmation record
  Authenticators       Authenticator[] // WebAuthn authenticators (optional)
  isGlobalAdmin        Boolean   @default(false) // Flag for super admin status

  workspaces           Workspace[] // Workspaces linked to the user
  accounts             Account[] // Linked authentication accounts (e.g., OAuth)
  sessions             Session[] // Active sessions of the user
  requestAssignments   RequestAssignment[] // Requests assigned to the user
  userRoles            UserRole[] // User's roles in the system
  members              Member[] // Memberships in groups or projects

  personId             String?    @db.UniqueIdentifier // Reference to the linked Person entity
  person               Person? // Optional link to Person entity
  userTenants          UserTenant[] // Relation to UserTenant

  // New relationship with UserArea
  userAreas            UserArea[] // Intermediate relationship between User and Area
}

model UserTenant {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  userId           String    @db.UniqueIdentifier
  tenantId         String    @db.UniqueIdentifier
  isActive         Boolean   @default(true) // Indicates if the user is active in the tenant
  joinedAt         DateTime  @default(now()) // Timestamp of when the user joined the tenant
  isSuperAdmin       Boolean   @default(false) // Flag for super admin status
  isCurrent       Boolean   @default(false) // Flag for the current tenant

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId]) // Ensure unique user-tenant relationships

  @@allow('read', isActive == true && (user.id == auth().id ))
  @@allow('update', isActive == true && (user.id == auth().id)) 
}

model UserRole extends TenantScoped, Auditable {
  // Primary identifier
  id              String    @id @default(uuid()) @db.UniqueIdentifier
  isActive       Boolean   @default(true) // Flag for active user role

  // Relationships
  userId          String    @db.UniqueIdentifier // Reference to the linked User
  roleId          String    @db.UniqueIdentifier // Reference to the linked Role
  user            User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role            Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Represents a system role within a tenant.
/// Roles define sets of features that can be assigned to users.
model Role extends TenantScoped, Auditable {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  name            String     @db.VarChar(100) @unique 
  description     String?    @db.VarChar(255) 

  // Relationships
  userRole        UserRole[] // Links this role to users via the UserRole model
  roleFeature  RoleFeature[] // Links this role to features via RoleFeature
}

/// Module also known as a feature or section of the application that can be enabled or disabled
/// in other terms, it also works as feature flags for the application to enable or disable features
/// based on if the module is enabled or disabled for the tenant or user
model Module extends TenantScoped, Auditable {
  // Primary identifier
  id              String     @id @default(uuid()) @db.UniqueIdentifier

  // Module details
  name            String     @db.VarChar(100) @unique // Module name (e.g., "Orders", "Settings")
  description     String?    @db.VarChar(255) // Optional module description
  isActive      Boolean    @default(true) // Flag for active module

  // Relationships
  feature      Feature[] // Features associated with this module
}

/// Represents features in the system. 
/// A single table handles both global features and area-specific features using the `scope` field.
/// Features are linked to modules for better organization and can be assigned to global roles or area roles.
model Feature extends TenantScoped, Auditable {
  // Unique identifier for the feature
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  name            String     @db.VarChar(50)
  key             String     @db.VarChar(100) @unique // Unique key for the feature
  description     String?    @db.VarChar(255) 

  // Scope of the feature: "global" for system-wide features or "area" for area-specific features
  scope           String     @default("global") // Example: "global", "area"

  // Reference to the module this feature belongs to, used for logical grouping of features
  moduleId        String     @db.UniqueIdentifier 
  module          Module     @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Links this feature to global roles
  roleFeature  RoleFeature[] 

  // Links this feature to area-specific roles
  areaRoleFeature AreaRoleFeature[] 

  // Links this feature to permissions
  planFeatures PlanFeature[]
  
  @@validate(scope in ["global", "area"])
}

model RoleFeature extends TenantScoped, Auditable {
  // Primary identifier
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  isActive       Boolean    @default(true) // Flag for active role feature

  // Relationships
  roleId          String     @db.UniqueIdentifier // Reference to the linked Role
  featureId    String     @db.UniqueIdentifier // Reference to the linked Feature
  role            Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature      Feature @relation(fields: [featureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Session {
  // Primary identifier
  id              String   @id @default(uuid()) @db.UniqueIdentifier

  // Session details
  sessionToken    String   @unique // Unique session token
  userId          String   @db.UniqueIdentifier // Reference to the linked User
  expires         DateTime // Expiration timestamp

  // Relationships
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId]) // Index for userId to optimize lookups
}

model Account {
  // Primary identifier
  id                       String   @id @default(uuid()) @db.UniqueIdentifier

  // Account details
  userId                   String   @db.UniqueIdentifier // Reference to the linked User
  type                     String   // Account type (e.g., OAuth, Password)
  provider                 String   // Provider name (e.g., "Google", "GitHub")
  providerAccountId        String   // Unique ID from the provider
  refresh_token            String?  @db.Text
  access_token             String?  @db.Text
  expires_at               Int?     // Expiration timestamp
  token_type               String?  // Type of token (e.g., "Bearer")
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  // Relationships
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId]) // Unique constraint for provider accounts
  @@index([userId]) // Index for userId
}

model VerificationToken {
  // Primary identifier
  id          String    @id @default(uuid()) @db.UniqueIdentifier

  // Token details
  email       String    // Email associated with the token
  token       String    @unique // Unique verification token
  expires     DateTime  // Expiration timestamp

  @@unique([email, token]) // Unique constraint for email-token pairs
}

model PasswordResetToken {
  // Primary identifier
  id          String    @id @default(uuid()) @db.UniqueIdentifier

  // Token details
  email       String    // Email associated with the token
  token       String    @unique // Unique reset token
  expires     DateTime  // Expiration timestamp

  @@unique([email, token]) // Unique constraint for email-token pairs
}

model TwoFactorToken {
  // Primary identifier
  id          String    @id @default(uuid()) @db.UniqueIdentifier

  // Token details
  email       String    // Email associated with the token
  token       String    @unique // Unique 2FA token
  expires     DateTime  // Expiration timestamp

  @@unique([email, token]) // Unique constraint for email-token pairs
}

model TwoFactorConfirmation {
  // Primary identifier
  id          String    @id @default(uuid()) @db.UniqueIdentifier

  // Relationships
  userId      String    @db.UniqueIdentifier // Reference to the linked User
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId]) // Unique constraint for userId
}

model Authenticator {
  // Primary identifier
  id                   String  @id @default(uuid()) @db.UniqueIdentifier

  // Authenticator details
  credentialID         String  @unique // Unique credential ID
  userId               String  @db.UniqueIdentifier // Reference to the linked User
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  // Relationships
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, providerAccountId]) // Unique constraint for user-provider account pairs
}
