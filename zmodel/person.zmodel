import './auth.zmodel'
import './abstract.zmodel'
import './request.zmodel'
import './tenant.zmodel'

model Person extends TenantScoped, Auditable {
  // Primary identifier
  id                    String     @id @default(uuid()) //@db.UniqueIdentifier

  // Personal details
  firstName             String     //@db.VarChar(100) // First name of the person
  lastName              String     //@db.VarChar(100) // Last name of the person
  phone                 String?    //@db.VarChar(50) // Optional phone number
  identificationNumber  String     @default("") //@db.VarChar(110) // Unique identification number
  image                 String?    // User's profile image

  // Relationships
  identificationTypeId  String?     //@db.UniqueIdentifier // Link to IdentificationType
  identificationType    IdentificationType? @relation(fields: [identificationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Type of identification

  userTenantId                String? @unique
  userTenant                  UserTenant?      @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked User entity

  @@unique([userTenantId, tenantId])
}


model IdentificationType extends TenantScoped, Auditable, CatalogBase {
  regex           String?    //@db.VarChar(500) // Optional regex to validate the identification number
  
  // Relationships
  person          Person[]   // Persons linked to this identification type

  @@index([name], name: "idx_identification_type_name")
  @@unique([name, tenantId])
}
