import './auth.zmodel'
import './abstract.zmodel'
import './request.zmodel'

model Person extends TenantScoped, Auditable {
  // Primary identifier
  id                    String     @id @default(uuid()) @db.UniqueIdentifier

  // Personal details
  firstName             String     @db.VarChar(100) // First name of the person
  lastName              String     @db.VarChar(100) // Last name of the person
  email                 String?    @unique // Optional unique email address
  phone                 String?    @db.VarChar(50) // Optional phone number
  identificationNumber  String     @db.VarChar(110) @unique // Unique identification number

  // Relationships
  userId                String?    @db.UniqueIdentifier @unique // Optional link to a User
  user                  User?      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked User entity

  clientId              String?    @db.UniqueIdentifier @unique // Optional link to a Client
  client                Client?    @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Linked Client entity

  identificationTypeId  String     @db.UniqueIdentifier // Link to IdentificationType
  identificationType    IdentificationType @relation(fields: [identificationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Type of identification

  @@map("Persons") // Map to the "Persons" table in the database
}

model Client extends TenantScoped, Auditable {
  // Primary identifier
  id                    String     @id @default(uuid()) @db.UniqueIdentifier

  // Client details
  name                  String     @db.VarChar(400) // Name of the client
  email                 String?    @db.VarChar(100) @unique // Optional unique email address
  identificationNumber  String     @db.VarChar(110) @unique // Unique identification number
  corporateName         String?    @db.VarChar(100) // Optional corporate name
  monthlyIncome         Float?     // Optional monthly income
  occupation            String?    @db.VarChar(100) // Optional occupation
  phone                 String?    @db.VarChar(50) // Optional phone number

  // Relationships
  personId              String?    @db.UniqueIdentifier // Optional link to a Person
  person                Person? // Linked Person entity

  request               Request[] // Requests made by the client

  @@map("Clients") // Map to the "Clients" table in the database

  // Policies
  @@allow('create', person != null) // Only allow creation if person is linked
}

model IdentificationType extends TenantScoped, Auditable {
  // Primary identifier
  id              String     @id @default(uuid()) @db.UniqueIdentifier

  // Identification type details
  name            String     @db.VarChar(150) @unique // Name of the identification type (e.g., "Passport")
  description     String?    @db.VarChar(500) // Optional description of the type

  // Relationships
  client          Person[]   // Persons linked to this identification type

  @@map("IdentificationTypes") // Map to the "IdentificationTypes" table in the database
}
