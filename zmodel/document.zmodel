import './abstract.zmodel'
import './request.zmodel'

model Document extends TenantScoped, Auditable {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  name            String   @db.VarChar(155)
  status          Int
  requestId       String   @db.UniqueIdentifier
  request         Request  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DocumentAssignment extends TenantScoped, Auditable {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  name            String?    @db.VarChar(50)
  status          String?    @db.VarChar(50)
  requestAssignmentId String @db.UniqueIdentifier
  requestAssignment RequestAssignment @relation(fields: [requestAssignmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
