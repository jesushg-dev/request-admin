  children MenuItem[] @relation("MenuItemToParent")
}

/// # Workflow Execution System
///
/// ## Core Workflow Definitions
/// @namespace CoreWorkflow
/// @erd CoreWorkflow
/// Represents a versioned workflow template containing nodes and edges
/// 
/// Relationships:
/// ╠═► nodes: Contains all component nodes
/// ╠═► edges: Defines transitions between nodes
/// ╠═► executions: Runtime instances using this template
/// ╚═► requestCategory: Business process classification
model ExecutionFlowDefinition {
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime?                 @updatedAt()
  deletedAt         DateTime?
  createdBy         String?                   @db.VarChar(50)
  updatedBy         String?                   @db.VarChar(50)
  tenantId          String
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String                    @id() @default(uuid())
  version           Int                       @default(1)
  nodes             ExecutionNodeDefinition[]
  edges             ExecutionEdgeDefinition[]
  isActive          Boolean                   @default(true)
  executions        ExecutionModelInstance[]
  previousHistories ExecutionModelHistory[]   @relation("PreviousFlowHistory")
  newHistories      ExecutionModelHistory[]   @relation("NewFlowHistory")
  requestCategoryId String?                   @unique()
  requestCategory   RequestCategory?          @relation(fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  viewportX         Float?
  viewportY         Float?
  viewportZoom      Float?

  @@unique([id, version])
  @@index([requestCategoryId])
}

/// Atomic unit in workflow execution path
/// @minItems 1
model ExecutionNodeDefinition {
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime?                 @updatedAt()
  deletedAt     DateTime?
  createdBy     String?                   @db.VarChar(50)
  updatedBy     String?                   @db.VarChar(50)
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String                    @id() @default(uuid())
  flow          ExecutionFlowDefinition   @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flowId        String
  type          String
  positionX     Float
  positionY     Float
  config        String
  edgesFrom     ExecutionEdgeDefinition[] @relation("SourceEdges")
  edgesTo       ExecutionEdgeDefinition[] @relation("TargetEdges")
  executionLogs ExecutionModelLog[]
  nodeGuide     ExecutionNodeGuide[]

  @@index([type])
}

/// Defines transitions between nodes with conditional logic
/// @minItems 1
model ExecutionEdgeDefinition {
  createdAt    DateTime                @default(now())
  updatedAt    DateTime?               @updatedAt()
  deletedAt    DateTime?
  createdBy    String?                 @db.VarChar(50)
  updatedBy    String?                 @db.VarChar(50)
  tenantId     String
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String                  @id() @default(uuid())
  flow         ExecutionFlowDefinition @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flowId       String
  source       ExecutionNodeDefinition @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceId     String
  target       ExecutionNodeDefinition @relation("TargetEdges", fields: [targetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetId     String
  sourceHandle String?
  style        String?
  markerEnd    String?

  @@index([sourceId, targetId])
}

/// ## Documentation System
/// @namespace Documentation
/// @erd Documentation
/// Links procedural guides to workflow nodes
model ExecutionNodeGuide {
  createdAt          DateTime                @default(now())
  updatedAt          DateTime?               @updatedAt()
  deletedAt          DateTime?
  createdBy          String?                 @db.VarChar(50)
  updatedBy          String?                 @db.VarChar(50)
  tenantId           String
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                 String                  @id() @default(uuid())
  applicationScope   String                  @default("full")
  customInstructions String?
  order              Int                     @default(1)
  guideId            String
  guide              GuideDocument           @relation(fields: [guideId], references: [id])
  nodeId             String
  node               ExecutionNodeDefinition @relation(fields: [nodeId], references: [id])

  @@unique([guideId, nodeId])
}

/// ## Runtime Execution Tracking
/// @namespace RuntimeExecution
/// @erd RuntimeExecution
/// Concrete instance of workflow execution
model ExecutionModelInstance {
  createdAt DateTime                @default(now())
  updatedAt DateTime?               @updatedAt()
  deletedAt DateTime?
  createdBy String?                 @db.VarChar(50)
  updatedBy String?                 @db.VarChar(50)
  tenantId  String
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String                  @id() @default(uuid())
  flow      ExecutionFlowDefinition @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flowId    String
  requestId String                  @unique()
  request   Request                 @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status    String
  logs      ExecutionModelLog[]
  history   ExecutionModelHistory[]

  @@unique([tenantId, flowId, requestId])
  @@index([status])
  @@index([tenantId, flowId, requestId])
}

/// Immutable execution audit record
/// @minItems 1
model ExecutionModelLog {
  createdAt   DateTime                @default(now())
  updatedAt   DateTime?               @updatedAt()
  deletedAt   DateTime?
  createdBy   String?                 @db.VarChar(50)
  updatedBy   String?                 @db.VarChar(50)
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String                  @id() @default(uuid())
  executionId String
  execution   ExecutionModelInstance  @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodeId      String
  node        ExecutionNodeDefinition @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  timestamp   DateTime                @default(now())
  eventType   String
  details     String
  outcome     String

  @@index([timestamp])
}

/// ## Version History Tracking
/// @namespace VersionHistory
/// @erd VersionHistory
/// Records workflow template migrations during execution
model ExecutionModelHistory {
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime?                @updatedAt()
  deletedAt      DateTime?
  createdBy      String?                  @db.VarChar(50)
  updatedBy      String?                  @db.VarChar(50)
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id             String                   @id() @default(uuid())
  executionId    String
  execution      ExecutionModelInstance   @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previousFlowId String?
  previousFlow   ExecutionFlowDefinition? @relation("PreviousFlowHistory", fields: [previousFlowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newFlowId      String
  newFlow        ExecutionFlowDefinition  @relation("NewFlowHistory", fields: [newFlowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reason         String

  @@index([updatedAt])
}

model UserTenantRole {
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt()
  deletedAt    DateTime?
  createdBy    String?    @db.VarChar(50)
  updatedBy    String?    @db.VarChar(50)
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String     @id() @default(uuid())
  isActive     Boolean    @default(true)
  userTenantId String
  roleId       String
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Represents a system role within a tenant.
/// Roles define sets of features that can be assigned to users.
model Role {
  id          String           @id() @default(uuid())
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt()
  deletedAt   DateTime?
  createdBy   String?          @db.VarChar(50)
  updatedBy   String?          @db.VarChar(50)
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRole    UserTenantRole[]
  roleFeature RoleFeature[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_role_name")
}

/// Module also known as a feature or section of the application that can be enabled or disabled
/// in other terms, it also works as feature flags for the application to enable or disable features
/// based on if the module is enabled or disabled for the tenant or user
model Module {
  id          String    @id() @default(uuid())
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  updatedBy   String?   @db.VarChar(50)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature     Feature[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_module_name")
}

/// Represents features in the system. 
/// A single table handles both global features and area-specific features using the `scope` field.
/// Features are linked to modules for better organization and can be assigned to global roles or area roles.
model Feature {
  id              String            @id() @default(uuid())
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(255)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?         @updatedAt()
  deletedAt       DateTime?
  createdBy       String?           @db.VarChar(50)
  updatedBy       String?           @db.VarChar(50)
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key             String            @unique() @db.VarChar(100)
  scope           String            @default("global")
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleFeature     RoleFeature[]
  areaRoleFeature AreaRoleFeature[]
  planFeatures    PlanFeature[]

  @@unique([key, tenantId])
}

model RoleFeature {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid())
  isActive  Boolean   @default(true)
  roleId    String
  featureId String
  role      Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Notification {
  tenantId   String
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id         String                  @id() @default(uuid())
  type       String
  body       String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt()
  recipients NotificationRecipient[]
}

model NotificationRecipient {
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id             String       @id() @default(uuid())
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String
  userTenant     UserTenant   @relation(fields: [userTenantId], references: [id])
  userTenantId   String
  readAt         DateTime?

  @@unique([notificationId, userTenantId])
  @@index([userTenantId])
}

model Channel {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid())
  name      String
  messages  Message[]
  requestId String?   @unique()
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requestId, tenantId])
  @@index([tenantId])
}

model Conversation {
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String     @id() @default(uuid())
  userTenantOneId String
  userTenantTwoId String
  userTenantOne   UserTenant @relation("UserTenantOne", fields: [userTenantOneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenantTwo   UserTenant @relation("UserTenantTwo", fields: [userTenantTwoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        Message[]

  @@unique([userTenantOneId, userTenantTwoId])
  @@index([userTenantOneId, userTenantTwoId])
}

model Message {
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt()
  deletedAt       DateTime?
  createdBy       String?       @db.VarChar(50)
  updatedBy       String?       @db.VarChar(50)
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String        @id() @default(uuid())
  body            String
  metadata        String        @default("{}")
  imageId         String?
  userTenantId    String
  channelId       String?
  parentMessageId String?
  conversationId  String?
  userTenant      UserTenant    @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel         Channel?      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  parentMessage   Message?      @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]     @relation("ParentMessage")
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions       Reaction[]

  @@index([userTenantId])
  @@index([channelId])
  @@index([parentMessageId])
  @@index([conversationId])
}

model Reaction {
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String     @id() @default(uuid())
  value        String
  messageId    String
  userTenantId String
  message      Message    @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([messageId, userTenantId])
  @@index([messageId])
  @@index([userTenantId])
}

model Person {
  createdAt            DateTime            @default(now())
  updatedAt            DateTime?           @updatedAt()
  deletedAt            DateTime?
  createdBy            String?             @db.VarChar(50)
  updatedBy            String?             @db.VarChar(50)
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                   String              @id() @default(uuid())
  firstName            String              @db.VarChar(100)
  lastName             String              @db.VarChar(100)
  phone                String?             @db.VarChar(50)
  identificationNumber String              @default("") @db.VarChar(110)
  image                String?
  identificationTypeId String?
  identificationType   IdentificationType? @relation(fields: [identificationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenantId         String?             @unique()
  userTenant           UserTenant?         @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userTenantId, tenantId])
}

model IdentificationType {
  id          String    @id() @default(uuid())
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  updatedBy   String?   @db.VarChar(50)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regex       String?   @db.VarChar(500)
  person      Person[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_identification_type_name")
}
