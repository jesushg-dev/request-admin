model UserTenant {
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime?               @updatedAt()
  deletedAt                    DateTime?
  createdBy                    String?                 @db.VarChar(50)
  updatedBy                    String?                 @db.VarChar(50)
  tenantId                     String
  tenant                       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                           String                  @id() @default(uuid())
  isActive                     Boolean                 @default(true)
  isTermAccepted               Boolean                 @default(false)
  joinedAt                     DateTime                @default(now())
  isTwoFactorRequired          Boolean                 @default(false)
  role                         String
  userId                       String
  user                         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId                     String?
  person                       Person?
  userAreas                    UserTenantArea[]
  userRoles                    UserTenantRole[]
  assignedUsers                AssignedUser[]
  reactions                    Reaction[]
  messages                     Message[]
  conversationsAsUserTenantOne Conversation[]          @relation("UserTenantOne")
  conversationsAsUserTenantTwo Conversation[]          @relation("UserTenantTwo")
  notifications                NotificationRecipient[]
  documents                    Document[]
  conversations                DocumentConversation[]
  restrictedTokens             RestrictedToken[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model InvitationTenant {
