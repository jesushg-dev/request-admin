  modifiedBy    String?     @db.VarChar(50)
  tenantId      String      @db.UniqueIdentifier()
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String      @id() @default(uuid()) @db.UniqueIdentifier()
  requirementId String      @db.UniqueIdentifier()
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId    String      @db.UniqueIdentifier()
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requirementId], name: "idx_category_requirement_id")
  @@index([categoryId], name: "idx_category_category_id")
}

/// Tracks compliance with requirements for a specific request.
model RequirementComplianceTracking {
  createdAt     DateTime    @default(now())
  updatedAt     DateTime?   @updatedAt()
  deletedAt     DateTime?
  createdBy     String?     @db.VarChar(50)
  modifiedBy    String?     @db.VarChar(50)
  tenantId      String      @db.UniqueIdentifier()
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String      @id() @default(uuid()) @db.UniqueIdentifier()
  requestId     String      @db.UniqueIdentifier()
  request       Request     @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirementId String      @db.UniqueIdentifier()
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isFulfilled   Boolean     @default(false)

  @@index([requestId], name: "idx_compliance_request_id")
  @@index([requirementId], name: "idx_compliance_requirement_id")
}

model Form {
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt()
  deletedAt      DateTime?
  createdBy      String?          @db.VarChar(50)
  modifiedBy     String?          @db.VarChar(50)
  tenantId       String           @db.UniqueIdentifier()
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id             String           @id() @default(uuid()) @db.UniqueIdentifier()
  userId         String           @db.UniqueIdentifier()
  name           String
  description    String           @default("")
  content        String           @default("[]")
  published      Boolean          @default(false)
  visits         Int              @default(0)
  submissions    Int              @default(0)
  shareURL       String           @unique() @default(uuid())
  Category       Category[]
  FormSubmission FormSubmission[]

  @@unique([name, userId])
}

model FormSubmission {
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt()
  deletedAt  DateTime?
  createdBy  String?   @db.VarChar(50)
  modifiedBy String?   @db.VarChar(50)
  tenantId   String    @db.UniqueIdentifier()
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id         String    @id() @default(uuid()) @db.UniqueIdentifier()
  formId     String    @db.UniqueIdentifier()
  content    String
  form       Form      @relation(fields: [formId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request    Request[]
}

model Document {
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt()
  deletedAt  DateTime?
  createdBy  String?   @db.VarChar(50)
  modifiedBy String?   @db.VarChar(50)
  tenantId   String    @db.UniqueIdentifier()
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id         String    @id() @default(uuid()) @db.UniqueIdentifier()
  name       String    @db.VarChar(155)
  status     Int
  requestId  String    @db.UniqueIdentifier()
  request    Request   @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DocumentAssignment {
  createdAt           DateTime          @default(now())
  updatedAt           DateTime?         @updatedAt()
  deletedAt           DateTime?
  createdBy           String?           @db.VarChar(50)
  modifiedBy          String?           @db.VarChar(50)
  tenantId            String            @db.UniqueIdentifier()
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                  String            @id() @default(uuid()) @db.UniqueIdentifier()
  name                String?           @db.VarChar(50)
  status              String?           @db.VarChar(50)
  requestAssignmentId String            @db.UniqueIdentifier()
  requestAssignment   RequestAssignment @relation(fields: [requestAssignmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Person {
  createdAt            DateTime           @default(now())
  updatedAt            DateTime?          @updatedAt()
  deletedAt            DateTime?
  createdBy            String?            @db.VarChar(50)
  modifiedBy           String?            @db.VarChar(50)
  tenantId             String             @db.UniqueIdentifier()
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                   String             @id() @default(uuid()) @db.UniqueIdentifier()
  firstName            String             @db.VarChar(100)
  lastName             String             @db.VarChar(100)
  email                String?            @unique()
  phone                String?            @db.VarChar(50)
  identificationNumber String             @unique() @default("") @db.VarChar(110)
  image                String?
  userId               String?            @unique() @db.UniqueIdentifier()
  user                 User?              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientId             String?            @unique() @db.UniqueIdentifier()
  client               Client?            @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  identificationTypeId String             @db.UniqueIdentifier()
  identificationType   IdentificationType @relation(fields: [identificationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Client {
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt()
  deletedAt     DateTime?
  createdBy     String?   @db.VarChar(50)
  modifiedBy    String?   @db.VarChar(50)
  tenantId      String    @db.UniqueIdentifier()
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String    @id() @default(uuid()) @db.UniqueIdentifier()
  corporateName String?   @db.VarChar(100)
  monthlyIncome Float?
  occupation    String?   @db.VarChar(100)
  personId      String?   @db.UniqueIdentifier()
  person        Person?
  request       Request[]
}

model IdentificationType {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  modifiedBy  String?   @db.VarChar(50)
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  name        String    @unique() @db.VarChar(150)
  description String?   @db.VarChar(500)
  client      Person[]
}

model Workspace {
  tenantId     String         @db.UniqueIdentifier()
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String         @id() @default(uuid()) @db.UniqueIdentifier()
  name         String
  joinCode     String
  userId       String         @db.UniqueIdentifier()
  user         User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members      Member[]
  channels     Channel[]
  messages     Message[]
  reactions    Reaction[]
  conversation Conversation[]

  @@index([userId])
}

model Member {
  tenantId                 String         @db.UniqueIdentifier()
  tenant                   Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                       String         @id() @default(uuid()) @db.UniqueIdentifier()
  userId                   String         @db.UniqueIdentifier()
  workspaceId              String         @db.UniqueIdentifier()
  user                     User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace                Workspace      @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions                Reaction[]
  messages                 Message[]
  conversationsAsMemberOne Conversation[] @relation("MemberOne")
  conversationsAsMemberTwo Conversation[] @relation("MemberTwo")

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model Channel {
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  name        String
  workspaceId String    @db.UniqueIdentifier()
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction)
  messages    Message[]

  @@index([workspaceId])
}

model Conversation {
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  workspaceId String    @db.UniqueIdentifier()
  memberOneId String    @db.UniqueIdentifier()
  memberTwoId String    @db.UniqueIdentifier()
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberOne   Member    @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberTwo   Member    @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages    Message[]

  @@index([workspaceId])
}

model Message {
  tenantId        String        @db.UniqueIdentifier()
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String        @id() @default(uuid()) @db.UniqueIdentifier()
  body            String
  imageId         String?       @db.UniqueIdentifier()
  updatedAt       DateTime?     @updatedAt()
  memberId        String        @db.UniqueIdentifier()
  workspaceId     String        @db.UniqueIdentifier()
  channelId       String?       @db.UniqueIdentifier()
  parentMessageId String?       @db.UniqueIdentifier()
  conversationId  String?       @db.UniqueIdentifier()
  member          Member        @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel         Channel?      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  parentMessage   Message?      @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]     @relation("ParentMessage")
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions       Reaction[]

  @@index([workspaceId])
  @@index([memberId])
  @@index([channelId])
  @@index([parentMessageId])
  @@index([conversationId])
  @@index([channelId, parentMessageId, conversationId])
}

model Reaction {
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  value       String
  workspaceId String    @db.UniqueIdentifier()
  messageId   String    @db.UniqueIdentifier()
  memberId    String    @db.UniqueIdentifier()
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId])
  @@index([messageId])
  @@index([memberId])
}
