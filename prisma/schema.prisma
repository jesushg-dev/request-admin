  id          String           @id() @default(uuid()) @db.UniqueIdentifier()
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt()
  deletedAt   DateTime?
  createdBy   String?          @db.VarChar(50)
  updatedBy   String?          @db.VarChar(50)
  tenantId    String           @db.UniqueIdentifier()
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRole    UserTenantRole[]
  roleFeature RoleFeature[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_role_name")
}

/// Module also known as a feature or section of the application that can be enabled or disabled
/// in other terms, it also works as feature flags for the application to enable or disable features
/// based on if the module is enabled or disabled for the tenant or user
model Module {
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  updatedBy   String?   @db.VarChar(50)
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature     Feature[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_module_name")
}

/// Represents features in the system. 
/// A single table handles both global features and area-specific features using the `scope` field.
/// Features are linked to modules for better organization and can be assigned to global roles or area roles.
model Feature {
  id              String            @id() @default(uuid()) @db.UniqueIdentifier()
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(255)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?         @updatedAt()
  deletedAt       DateTime?
  createdBy       String?           @db.VarChar(50)
  updatedBy       String?           @db.VarChar(50)
  tenantId        String            @db.UniqueIdentifier()
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key             String            @unique() @db.VarChar(100)
  scope           String            @default("global")
  moduleId        String            @db.UniqueIdentifier()
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleFeature     RoleFeature[]
  areaRoleFeature AreaRoleFeature[]
  planFeatures    PlanFeature[]

  @@unique([key, tenantId])
}

model RoleFeature {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String    @db.UniqueIdentifier()
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid()) @db.UniqueIdentifier()
  isActive  Boolean   @default(true)
  roleId    String    @db.UniqueIdentifier()
  featureId String    @db.UniqueIdentifier()
  role      Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Channel {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String    @db.UniqueIdentifier()
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid()) @db.UniqueIdentifier()
  name      String
  messages  Message[]
  requestId String?   @unique() @db.UniqueIdentifier()
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requestId, tenantId])
  @@index([tenantId])
}

model Conversation {
  tenantId        String     @db.UniqueIdentifier()
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String     @id() @default(uuid()) @db.UniqueIdentifier()
  userTenantOneId String     @db.UniqueIdentifier()
  userTenantTwoId String     @db.UniqueIdentifier()
  userTenantOne   UserTenant @relation("UserTenantOne", fields: [userTenantOneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenantTwo   UserTenant @relation("UserTenantTwo", fields: [userTenantTwoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        Message[]

  @@unique([userTenantOneId, userTenantTwoId])
  @@index([userTenantOneId, userTenantTwoId])
}

model Message {
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt()
  deletedAt       DateTime?
  createdBy       String?       @db.VarChar(50)
  updatedBy       String?       @db.VarChar(50)
  tenantId        String        @db.UniqueIdentifier()
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String        @id() @default(uuid()) @db.UniqueIdentifier()
  body            String
  imageId         String?
  userTenantId    String        @db.UniqueIdentifier()
  channelId       String?       @db.UniqueIdentifier()
  parentMessageId String?       @db.UniqueIdentifier()
  conversationId  String?       @db.UniqueIdentifier()
  userTenant      UserTenant    @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel         Channel?      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  parentMessage   Message?      @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]     @relation("ParentMessage")
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions       Reaction[]

  @@index([userTenantId])
  @@index([channelId])
  @@index([parentMessageId])
  @@index([conversationId])
}

model Reaction {
  tenantId     String     @db.UniqueIdentifier()
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String     @id() @default(uuid()) @db.UniqueIdentifier()
  value        String
  messageId    String     @db.UniqueIdentifier()
  userTenantId String     @db.UniqueIdentifier()
  message      Message    @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([messageId, userTenantId])
  @@index([messageId])
  @@index([userTenantId])
}

model Person {
  createdAt            DateTime           @default(now())
  updatedAt            DateTime?          @updatedAt()
  deletedAt            DateTime?
  createdBy            String?            @db.VarChar(50)
  updatedBy            String?            @db.VarChar(50)
  tenantId             String             @db.UniqueIdentifier()
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                   String             @id() @default(uuid()) @db.UniqueIdentifier()
  firstName            String             @db.VarChar(100)
  lastName             String             @db.VarChar(100)
  phone                String?            @db.VarChar(50)
  identificationNumber String             @default("") @db.VarChar(110)
  image                String?
  userTenantId         String?            @unique() @db.UniqueIdentifier()
  userTenant           UserTenant?        @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  identificationTypeId String             @db.UniqueIdentifier()
  identificationType   IdentificationType @relation(fields: [identificationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([phone, tenantId])
  @@unique([userTenantId, tenantId])
  @@unique([identificationNumber, tenantId])
}

model IdentificationType {
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  updatedBy   String?   @db.VarChar(50)
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regex       String?   @db.VarChar(500)
  person      Person[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_identification_type_name")
}
