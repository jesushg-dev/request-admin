  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime?                       @updatedAt()
  deletedAt                     DateTime?
  createdBy                     String?                         @db.VarChar(50)
  updatedBy                     String?                         @db.VarChar(50)
  tenantId                      String                          @db.UniqueIdentifier()
  tenant                        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isRequiredOnlyOnce            Boolean                         @default(false)
  requirementComplianceTracking RequirementComplianceTracking[]
  requestCategoryRequirements   RequestCategoryRequirement[]
  requirementTypeId             String                          @db.UniqueIdentifier()
