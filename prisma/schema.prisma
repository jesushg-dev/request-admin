/// Represents a request that includes categorization for both request and assignment with ITIL compliance tracking
model Request {
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime?                       @updatedAt()
  deletedAt                DateTime?
  createdBy                String?                         @db.VarChar(50)
  updatedBy                String?                         @db.VarChar(50)
  tenantId                 String
  tenant                   Tenant                          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                       String                          @id() @default(uuid())
  slug                     Int                             @default(autoincrement())
  issueSubject             String                          @db.VarChar(255)
  description              String?                         @db.VarChar(5000)
  isDraft                  Boolean                         @default(true)
  closedAt                 DateTime?
  closedBy                 String?                         @db.VarChar(50)
  closedComment            String?                         @db.VarChar(500)
  formSubmission           FormSubmission[]
  complianceTrackings      RequirementComplianceTracking[]
  requestAssignments       RequestAssignment[]
  changeLog                RequestChangeLog[]
  dataroomId               String?
  dataroom                 Dataroom?
  satisfactionSurveyId     String?
  satisfactionSurvey       CustomerSatisfactionSurvey?     @relation("RequestSurvey")
  channelId                String?
  channel                  Channel?
  executionModelInstanceId String?
  executionModelInstance   ExecutionModelInstance?

  @@index([closedAt], name: "idx_request_closed_at")
  @@index([closedBy], name: "idx_request_closed_by")
  @@index([closedComment], name: "idx_request_closed_comment")
  @@index([issueSubject], name: "idx_request_issue_subject")
}

/// Represents an assignment of a request to users or areas.
model RequestAssignment {
  createdAt            DateTime              @default(now())
  updatedAt            DateTime?             @updatedAt()
  deletedAt            DateTime?
  createdBy            String?               @db.VarChar(50)
  updatedBy            String?               @db.VarChar(50)
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                   String                @id() @default(uuid())
  comment              String?               @db.VarChar(255)
  assignmentDate       DateTime              @default(now())
  unAssignmentDate     DateTime?
  requestId            String
  request              Request               @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedUsers        AssignedUser[]        @relation("AssignedUsers")
  slaStart             DateTime?
  slaDeadline          DateTime?
  slaEnd               DateTime?
  areaId               String
  area                 Area                  @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statusId             String
  status               RequestWorkflowStatus @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  typeId               String
  type                 AssignmentType        @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priorityId           String
  priority             RequestPriorityType   @relation(fields: [priorityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive             Boolean               @default(true)
  requestCategoryId    String
  requestCategory      RequestCategory       @relation("RequestCategory", fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignmentCategoryId String
  assignmentCategory   AssignmentCategory    @relation("AssignmentCategory", fields: [assignmentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([typeId], name: "idx_assignment_type_id")
  @@index([requestId], name: "idx_assignment_request_id")
  @@index([statusId], name: "idx_assignment_status_id")
  @@index([slaStart], name: "idx_assignment_sla_start")
  @@index([slaDeadline], name: "idx_assignment_sla_deadline")
  @@index([slaEnd], name: "idx_assignment_sla_end")
  @@index([requestCategoryId], name: "idx_assignment_request_category_id")
  @@index([assignmentCategoryId], name: "idx_assignment_assignment_category_id")
}

/// Represents the users assigned to a request, including the coordinator.
model AssignedUser {
  createdAt           DateTime          @default(now())
  updatedAt           DateTime?         @updatedAt()
  deletedAt           DateTime?
  createdBy           String?           @db.VarChar(50)
  updatedBy           String?           @db.VarChar(50)
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                  String            @id() @default(uuid())
  requestAssignment   RequestAssignment @relation("AssignedUsers", fields: [requestAssignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requestAssignmentId String
  userTenantId        String
  userTenant          UserTenant        @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role                String            @db.VarChar(150)
  unAssignmentDate    DateTime?
  isCoordinator       Boolean           @default(false)
}

/// Represents a catalog of possible priority levels for requests or assignments.
model RequestPriorityType {
  id           String              @id() @default(uuid())
  name         String              @db.VarChar(100)
  description  String?             @db.VarChar(255)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime?           @updatedAt()
  deletedAt    DateTime?
  createdBy    String?             @db.VarChar(50)
  updatedBy    String?             @db.VarChar(50)
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  primaryColor String              @db.VarChar(10)
  level        Int
  isDefault    Boolean             @default(false)
  assignments  RequestAssignment[]

  @@unique([name, tenantId])
}

model AssignmentType {
  id          String              @id() @default(uuid())
  name        String              @db.VarChar(100)
  description String?             @db.VarChar(255)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime?           @updatedAt()
  deletedAt   DateTime?
  createdBy   String?             @db.VarChar(50)
  updatedBy   String?             @db.VarChar(50)
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  systemName  String              @db.VarChar(100)
  assignments RequestAssignment[]

  @@unique([name, tenantId])
}

model RequestWorkflow {
  id                        String                      @id() @default(uuid())
  name                      String                      @db.VarChar(100)
  description               String?                     @db.VarChar(255)
  isActive                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime?                   @updatedAt()
  deletedAt                 DateTime?
  createdBy                 String?                     @db.VarChar(50)
  updatedBy                 String?                     @db.VarChar(50)
  tenantId                  String
  tenant                    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isDefault                 Boolean                     @default(false)
  requireComments           Boolean                     @default(false)
  notifyChanges             Boolean                     @default(false)
  requestCategory           RequestCategory[]
  requestWorkflowStatus     RequestWorkflowStatus[]     @relation("RequestWorkflowStatus")
  requestWorkflowTransition RequestWorkflowTransition[] @relation("RequestWorkflowTransition")
}

model RequestWorkflowStatus {
  id              String                      @id() @default(uuid())
  name            String                      @db.VarChar(100)
  description     String?                     @db.VarChar(255)
  isActive        Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime?                   @updatedAt()
  deletedAt       DateTime?
  createdBy       String?                     @db.VarChar(50)
  updatedBy       String?                     @db.VarChar(50)
  tenantId        String
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  color           String
  type            String
  positionX       Float
  positionY       Float
  workflowId      String
  workflow        RequestWorkflow             @relation("RequestWorkflowStatus", fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments     RequestAssignment[]
  fromTransitions RequestWorkflowTransition[] @relation("FromStatus")
  toTransitions   RequestWorkflowTransition[] @relation("ToStatus")

  @@index([type], name: "idx_status_type")
}

model RequestWorkflowTransition {
  id                    String                @id() @default(uuid())
  name                  String                @db.VarChar(100)
  description           String?               @db.VarChar(255)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime?             @updatedAt()
  deletedAt             DateTime?
  createdBy             String?               @db.VarChar(50)
  updatedBy             String?               @db.VarChar(50)
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priority              Int                   @default(0)
  maxDuration           Int?
  notifyAfter           Int?
  requiresApproval      Boolean               @default(false)
  requiresJustification Boolean               @default(false)
  workflowId            String
  workflow              RequestWorkflow       @relation("RequestWorkflowTransition", fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromStatusId          String
  toStatusId            String
  fromStatus            RequestWorkflowStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toStatus              RequestWorkflowStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, fromStatusId, toStatusId], name: "unique_transition_path_per_tenant")
  @@index([fromStatusId], name: "idx_transition_source")
  @@index([toStatusId], name: "idx_transition_target")
}

/// Tracks compliance with requirements for a specific request.
model RequirementComplianceTracking {
  createdAt     DateTime    @default(now())
  updatedAt     DateTime?   @updatedAt()
  deletedAt     DateTime?
  createdBy     String?     @db.VarChar(50)
  updatedBy     String?     @db.VarChar(50)
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String      @id() @default(uuid())
  requestId     String
  request       Request     @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isFulfilled   Boolean     @default(false)
  isArchived    Boolean     @default(false)
  document      Document[]

  @@unique([requestId, requirementId, tenantId], name: "unique_compliance_tracking")
  @@index([requestId], name: "idx_compliance_request_id")
  @@index([requirementId], name: "idx_compliance_requirement_id")
}

/// Tracks customer satisfaction surveys for closed requests.
model CustomerSatisfactionSurvey {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  updatedBy   String?   @db.VarChar(50)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid())
  rating      Int
  feedback    String?   @db.VarChar(1000)
  submittedAt DateTime
  requestId   String    @unique()
  request     Request   @relation("RequestSurvey", fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestId], name: "idx_survey_request_id")
}

/// Logs changes to requests for auditing purposes.
model RequestChangeLog {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid())
  requestId String
  request   Request   @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldName String    @db.VarChar(100)
  oldValue  String?   @db.VarChar(500)
  newValue  String?   @db.VarChar(500)
  metadata  String?   @db.Text()

  @@index([requestId], name: "idx_change_log_request_id")
  @@index([updatedBy], name: "idx_change_log_changed_by")
}

model Document {
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime?                      @updatedAt()
  deletedAt                       DateTime?
  createdBy                       String?                        @db.VarChar(50)
  updatedBy                       String?                        @db.VarChar(50)
  tenantId                        String
  tenant                          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                              String                         @id() @default(uuid())
  name                            String                         @db.VarChar(155)
  description                     String?
  file                            String
  originalFile                    String?
  type                            String
  contentType                     String
  storageType                     String                         @default("UPLOADTHING")
  numPages                        Int?
  expirationDate                  DateTime?
  status                          String                         @default("ACTIVE")
  assistantEnabled                Boolean                        @default(false)
  advancedExcelEnabled            Boolean                        @default(false)
