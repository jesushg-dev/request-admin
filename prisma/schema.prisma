/// Represents an organizational area within a tenant.
/// Areas allow grouping of users, categories, and request assignments in a specific organizational scope.
model Area {
  id                    String                @id() @default(uuid()) @db.UniqueIdentifier()
  name                  String                @db.VarChar(100)
  description           String?               @db.VarChar(255)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime?             @updatedAt()
  deletedAt             DateTime?
  createdBy             String?               @db.VarChar(50)
  updatedBy             String?               @db.VarChar(50)
  tenantId              String                @db.UniqueIdentifier()
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestAssignments    RequestAssignment[]
  assignmentCategories  AssignmentCategory[]
  userAreas             UserTenantArea[]
  areaRole              AreaRole[]
  assignmentHierarchies AssignmentHierarchy[]

  @@unique([name, tenantId])
  @@index([name, tenantId], name: "idx_area_name")
}

/// Represents the assignment of users to areas with specific roles.
/// This model acts as an intermediate table for associating users, areas, and area-specific roles.
model UserTenantArea {
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt()
  deletedAt    DateTime?
  createdBy    String?    @db.VarChar(50)
  updatedBy    String?    @db.VarChar(50)
  tenantId     String     @db.UniqueIdentifier()
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String     @id() @default(uuid()) @db.UniqueIdentifier()
  isActive     Boolean    @default(true)
  userTenantId String     @db.UniqueIdentifier()
  areaId       String     @db.UniqueIdentifier()
  roleId       String     @db.UniqueIdentifier()
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area         Area       @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         AreaRole   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userTenantId, areaId, tenantId])
}

/// Represents roles that are specific to an area.
/// Area roles define features and responsibilities of users within a specific organizational area.
model AreaRole {
  id               String            @id() @default(uuid()) @db.UniqueIdentifier()
  name             String            @db.VarChar(100)
  description      String?           @db.VarChar(255)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt()
  deletedAt        DateTime?
  createdBy        String?           @db.VarChar(50)
  updatedBy        String?           @db.VarChar(50)
  tenantId         String            @db.UniqueIdentifier()
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  areaId           String            @db.UniqueIdentifier()
  area             Area              @relation(fields: [areaId], references: [id])
  userAreas        UserTenantArea[]
  areaRoleFeatures AreaRoleFeature[]

  @@unique([name, areaId, tenantId])
}

/// Links area-specific roles to features.
/// This model defines which features are granted to roles within a specific area.
model AreaRoleFeature {
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt()
  deletedAt  DateTime?
  createdBy  String?   @db.VarChar(50)
  updatedBy  String?   @db.VarChar(50)
  tenantId   String    @db.UniqueIdentifier()
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id         String    @id() @default(uuid()) @db.UniqueIdentifier()
  isActive   Boolean   @default(true)
  areaRoleId String    @db.UniqueIdentifier()
  areaRole   AreaRole  @relation(fields: [areaRoleId], references: [id])
  featureId  String    @db.UniqueIdentifier()
  feature    Feature   @relation(fields: [featureId], references: [id])

  @@unique([areaRoleId, featureId, tenantId])
}

/// Represents a hierarchy for requests.
model RequestHierarchy {
  id          String                  @id() @default(uuid()) @db.UniqueIdentifier()
  name        String                  @db.VarChar(100)
  description String?                 @db.VarChar(255)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime?               @updatedAt()
