/// Represents a request category, with SLA and required documents.
model RequestCategory {
  id                          String                       @id() @default(uuid()) @db.UniqueIdentifier()
  name                        String                       @db.VarChar(100)
  description                 String?                      @db.VarChar(255)
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime?                    @updatedAt()
  deletedAt                   DateTime?
  createdBy                   String?                      @db.VarChar(50)
  updatedBy                   String?                      @db.VarChar(50)
  tenantId                    String                       @db.UniqueIdentifier()
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentCategoryId            String?                      @db.UniqueIdentifier()
  parentCategory              RequestCategory?             @relation("ParentRequestCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories               RequestCategory[]            @relation("ParentRequestCategory")
  hierarchyLevelId            String                       @db.UniqueIdentifier()
  hierarchyLevel              RequestHierarchyLevel        @relation(fields: [hierarchyLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchyId                 String                       @db.UniqueIdentifier()
