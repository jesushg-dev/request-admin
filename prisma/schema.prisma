  createdBy   String?                 @db.VarChar(50)
  updatedBy   String?                 @db.VarChar(50)
  tenantId    String                  @db.UniqueIdentifier()
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels      RequestHierarchyLevel[]
  categories  RequestCategory[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_request_hierarchy_name")
}

/// Represents a level within a request hierarchy.
model RequestHierarchyLevel {
  id          String            @id() @default(uuid()) @db.UniqueIdentifier()
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(255)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?         @updatedAt()
