/// Represents a service request that includes categorization for both service and assignment.
model Request {
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime?                       @updatedAt()
  deletedAt            DateTime?
  createdBy            String?                         @db.VarChar(50)
  modifiedBy           String?                         @db.VarChar(50)
  tenantId             String                          @db.UniqueIdentifier()
  tenant               Tenant                          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                   String                          @id() @default(uuid()) @db.UniqueIdentifier()
  clientId             String                          @db.UniqueIdentifier()
  issueSubject         String?                         @db.VarChar(255)
  description          String?                         @db.VarChar(5000)
  priority             String?                         @db.VarChar(50)
  closedAt             DateTime?
  closedBy             String?                         @db.VarChar(50)
  closedComment        String?                         @db.VarChar(500)
  comment              String?                         @db.VarChar(255)
  /// Status categorization (e.g., "Open", "Closed", "In Progress").
  statusId             String                          @db.UniqueIdentifier()
  status               StatusType                      @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Service categorization (e.g., "Sales Channel > Service Type").
  serviceCategoryId    String                          @db.UniqueIdentifier()
  serviceCategory      Category                        @relation("ServiceCategory", fields: [serviceCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Assignment categorization (e.g., "Area > Case Type > Category > Subcategory").
  assignmentCategoryId String                          @db.UniqueIdentifier()
