  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime?                  @updatedAt()
  deletedAt   DateTime?
  createdBy   String?                    @db.VarChar(50)
  updatedBy   String?                    @db.VarChar(50)
  tenantId    String                     @db.UniqueIdentifier()
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels      AssignmentHierarchyLevel[]
  categories  AssignmentCategory[]
  areaId      String?                    @db.UniqueIdentifier()
  area        Area?                      @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, tenantId])
  @@index([name], name: "idx_assignment_hierarchy_name")
}

/// Represents a level within an assignment hierarchy.
model AssignmentHierarchyLevel {
  id          String               @id() @default(uuid()) @db.UniqueIdentifier()
  name        String               @db.VarChar(100)
  description String?              @db.VarChar(255)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime?            @updatedAt()
  deletedAt   DateTime?
  createdBy   String?              @db.VarChar(50)
  updatedBy   String?              @db.VarChar(50)
  tenantId    String               @db.UniqueIdentifier()
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchyId String               @db.UniqueIdentifier()
  hierarchy   AssignmentHierarchy  @relation(fields: [hierarchyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories  AssignmentCategory[]
  position    Int

  @@unique([position, hierarchyId])
  @@unique([hierarchyId, position], name: "unique_hierarchy_position")
  @@unique([name, tenantId])
  @@index([hierarchyId], name: "idx_assignment_hierarchy_level_hierarchy_id")
}

/// Represents an assignment category, linked to specific rules and an area.
/// Represents an assignment category, linked to specific rules and an area.
model AssignmentCategory {
  id                 String                   @id() @default(uuid()) @db.UniqueIdentifier()
  name               String                   @db.VarChar(100)
  description        String?                  @db.VarChar(255)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime?                @updatedAt()
  deletedAt          DateTime?
  createdBy          String?                  @db.VarChar(50)
  updatedBy          String?                  @db.VarChar(50)
  tenantId           String                   @db.UniqueIdentifier()
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentCategoryId   String?                  @db.UniqueIdentifier()
  parentCategory     AssignmentCategory?      @relation("ParentAssignmentCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories      AssignmentCategory[]     @relation("ParentAssignmentCategory")
  hierarchyLevelId   String                   @db.UniqueIdentifier()
  hierarchyLevel     AssignmentHierarchyLevel @relation(fields: [hierarchyLevelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hierarchyId        String                   @db.UniqueIdentifier()
  hierarchy          AssignmentHierarchy      @relation(fields: [hierarchyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  areaId             String                   @db.UniqueIdentifier()
  area               Area                     @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignmentRequests RequestAssignment[]      @relation("AssignmentCategory")

  @@unique([name, hierarchyLevelId, areaId, parentCategoryId, tenantId])
  @@index([name, tenantId], name: "idx_assignment_category_name_tenant")
  @@index([hierarchyId, tenantId], name: "idx_assignment_category_hierarchy_tenant")
  @@index([areaId, tenantId], name: "idx_assignment_category_area_tenant")
}

model Form {
  id              String           @id() @default(uuid()) @db.UniqueIdentifier()
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt()
  deletedAt       DateTime?
  createdBy       String?          @db.VarChar(50)
  updatedBy       String?          @db.VarChar(50)
  tenantId        String           @db.UniqueIdentifier()
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId          String           @db.UniqueIdentifier()
  content         String           @default("[]") @db.NVarChar(Max)
  published       Boolean          @default(false)
  isPublic        Boolean          @default(false)
  visits          Int              @default(0)
  submissions     Int              @default(0)
  shareURL        String           @unique() @default(uuid())
  categoryForms   CategoryForm[]
  formSubmissions FormSubmission[]

  @@unique([name, tenantId])
}

model FormSubmission {
  createdAt DateTime            @default(now())
  updatedAt DateTime?           @updatedAt()
  deletedAt DateTime?
  createdBy String?             @db.VarChar(50)
  updatedBy String?             @db.VarChar(50)
  tenantId  String              @db.UniqueIdentifier()
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String              @id() @default(uuid()) @db.UniqueIdentifier()
  formId    String              @db.UniqueIdentifier()
  content   String
  keys      FormSubmissionKey[]
  form      Form                @relation(fields: [formId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId String?             @db.UniqueIdentifier()
  request   Request?            @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([formId, tenantId, requestId])
  @@index([formId])
}

model FormSubmissionKey {
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt()
  deletedAt    DateTime?
  createdBy    String?        @db.VarChar(50)
  updatedBy    String?        @db.VarChar(50)
  tenantId     String         @db.UniqueIdentifier()
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String         @id() @default(uuid()) @db.UniqueIdentifier()
  submissionId String         @db.UniqueIdentifier()
  key          String         @db.VarChar(255)
  value        String         @db.VarChar(255)
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([key, value])
}

model MenuItem {
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt()
  deletedAt DateTime?
  createdBy String?    @db.VarChar(50)
  updatedBy String?    @db.VarChar(50)
  tenantId  String     @db.UniqueIdentifier()
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String     @id() @default(uuid()) @db.UniqueIdentifier()
  title     String
  icon      String?
  position  Int        @default(0)
  isActive  Boolean    @default(false)
  pathname  String
  slug      String
  parentId  String?    @db.UniqueIdentifier()
  parent    MenuItem?  @relation("MenuItemToParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  MenuItem[] @relation("MenuItemToParent")
}

model UserTenantRole {
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt()
  deletedAt    DateTime?
  createdBy    String?    @db.VarChar(50)
  updatedBy    String?    @db.VarChar(50)
  tenantId     String     @db.UniqueIdentifier()
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String     @id() @default(uuid()) @db.UniqueIdentifier()
  isActive     Boolean    @default(true)
  userTenantId String     @db.UniqueIdentifier()
  roleId       String     @db.UniqueIdentifier()
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Represents a system role within a tenant.
/// Roles define sets of features that can be assigned to users.
model Role {
  id          String           @id() @default(uuid()) @db.UniqueIdentifier()
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt()
  deletedAt   DateTime?
  createdBy   String?          @db.VarChar(50)
  updatedBy   String?          @db.VarChar(50)
  tenantId    String           @db.UniqueIdentifier()
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRole    UserTenantRole[]
  roleFeature RoleFeature[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_role_name")
}

/// Module also known as a feature or section of the application that can be enabled or disabled
/// in other terms, it also works as feature flags for the application to enable or disable features
/// based on if the module is enabled or disabled for the tenant or user
model Module {
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt()
  deletedAt   DateTime?
  createdBy   String?   @db.VarChar(50)
  updatedBy   String?   @db.VarChar(50)
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature     Feature[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_module_name")
}

/// Represents features in the system. 
/// A single table handles both global features and area-specific features using the `scope` field.
/// Features are linked to modules for better organization and can be assigned to global roles or area roles.
model Feature {
  id              String            @id() @default(uuid()) @db.UniqueIdentifier()
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(255)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?         @updatedAt()
  deletedAt       DateTime?
  createdBy       String?           @db.VarChar(50)
  updatedBy       String?           @db.VarChar(50)
  tenantId        String            @db.UniqueIdentifier()
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key             String            @unique() @db.VarChar(100)
  scope           String            @default("global")
  moduleId        String            @db.UniqueIdentifier()
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleFeature     RoleFeature[]
  areaRoleFeature AreaRoleFeature[]
  planFeatures    PlanFeature[]

  @@unique([key, tenantId])
}

model RoleFeature {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String    @db.UniqueIdentifier()
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid()) @db.UniqueIdentifier()
  isActive  Boolean   @default(true)
  roleId    String    @db.UniqueIdentifier()
  featureId String    @db.UniqueIdentifier()
  role      Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Channel {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?
  createdBy String?   @db.VarChar(50)
  updatedBy String?   @db.VarChar(50)
  tenantId  String    @db.UniqueIdentifier()
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String    @id() @default(uuid()) @db.UniqueIdentifier()
  name      String
  messages  Message[]
  requestId String?   @unique() @db.UniqueIdentifier()
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

