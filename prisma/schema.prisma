  id                String    @id() @default(uuid()) @db.UniqueIdentifier()
  slaId             String    @db.UniqueIdentifier()
  sla               SLA       @relation(fields: [slaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oldResolutionTime Int?
  newResolutionTime Int

