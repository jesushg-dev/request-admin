  formSubmissionId     String?                         @db.UniqueIdentifier()
  formSubmission       FormSubmission?                 @relation(fields: [formSubmissionId], references: [id])
  documents            Document[]
  requestAssignments   RequestAssignment[]
  complianceTrackings  RequirementComplianceTracking[]

  @@index([serviceCategoryId], name: "idx_request_service_category_id")
  @@index([assignmentCategoryId], name: "idx_request_assignment_category_id")
  @@index([clientId], name: "idx_request_client_id")
}

