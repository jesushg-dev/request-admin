  categoryForms               CategoryForm[]
  requestCategoryRequirements RequestCategoryRequirement[]
  requests                    RequestAssignment[]          @relation("RequestCategory")

  @@unique([name, hierarchyLevelId, parentCategoryId, tenantId])
  @@index([name], name: "idx_request_category_name")
  @@index([hierarchyId], name: "idx_request_category_hierarchy_id")
}

model CategoryForm {
  createdAt         DateTime        @default(now())
  updatedAt         DateTime?       @updatedAt()
  deletedAt         DateTime?
  createdBy         String?         @db.VarChar(50)
  updatedBy         String?         @db.VarChar(50)
  tenantId          String          @db.UniqueIdentifier()
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String          @id() @default(uuid()) @db.UniqueIdentifier()
  isActive          Boolean         @default(true)
  categoryId        String          @db.UniqueIdentifier()
  formId            String          @db.UniqueIdentifier()
  requestCategories RequestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  form              Form            @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, formId, tenantId])
}

/// SLA (Service Level Agreement) model.
model SLA {
  createdAt         DateTime         @default(now())
  updatedAt         DateTime?        @updatedAt()
  deletedAt         DateTime?
  createdBy         String?          @db.VarChar(50)
  updatedBy         String?          @db.VarChar(50)
  tenantId          String           @db.UniqueIdentifier()
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String           @id() @default(uuid()) @db.UniqueIdentifier()
  resolutionTime    Int
  escalationTime    Int?
  requestCategoryId String?          @unique() @db.UniqueIdentifier()
  requestCategory   RequestCategory? @relation(fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changeLogs        SLAChangeLog[]

  @@index([requestCategoryId], name: "idx_sla_request_category_id")
}

model SLAChangeLog {
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt()
  deletedAt         DateTime?
  createdBy         String?   @db.VarChar(50)
  updatedBy         String?   @db.VarChar(50)
  tenantId          String    @db.UniqueIdentifier()
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String    @id() @default(uuid()) @db.UniqueIdentifier()
  slaId             String    @db.UniqueIdentifier()
  sla               SLA       @relation(fields: [slaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oldResolutionTime Int?
  newResolutionTime Int

  @@index([slaId], name: "idx_sla_change_log_sla_id")
}

/// Represents a guide document used to resolve a request.
model GuideDocument {
  id                String          @id() @default(uuid()) @db.UniqueIdentifier()
  name              String          @db.VarChar(100)
  description       String?         @db.VarChar(255)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime?       @updatedAt()
  deletedAt         DateTime?
  createdBy         String?         @db.VarChar(50)
  updatedBy         String?         @db.VarChar(50)
  tenantId          String          @db.UniqueIdentifier()
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  url               String?         @db.VarChar(500)
  status            Int
  expirationDate    DateTime?
  version           Int             @default(1)
  requestCategoryId String          @db.UniqueIdentifier()
  requestCategory   RequestCategory @relation(fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, tenantId])
  @@index([requestCategoryId], name: "idx_guide_document_request_category_id")
}

/// Represents a specific requirement for a request/assignment category.
model Requirement {
  id                            String                          @id() @default(uuid()) @db.UniqueIdentifier()
  name                          String                          @db.VarChar(100)
  description                   String?                         @db.VarChar(255)
  isActive                      Boolean                         @default(true)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime?                       @updatedAt()
  deletedAt                     DateTime?
  createdBy                     String?                         @db.VarChar(50)
  updatedBy                     String?                         @db.VarChar(50)
  tenantId                      String                          @db.UniqueIdentifier()
  tenant                        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isRequiredOnlyOnce            Boolean                         @default(false)
  requirementComplianceTracking RequirementComplianceTracking[]
  requestCategoryRequirements   RequestCategoryRequirement[]
  requirementTypeId             String                          @db.UniqueIdentifier()
  requirementType               RequirementType                 @relation(fields: [requirementTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, tenantId], name: "idx_requirement_name_tenant")
  @@index([name], name: "idx_requirement_name")
}

/// Links a requirement to a specific category.
model RequestCategoryRequirement {
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?       @updatedAt()
  deletedAt       DateTime?
  createdBy       String?         @db.VarChar(50)
  updatedBy       String?         @db.VarChar(50)
  tenantId        String          @db.UniqueIdentifier()
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String          @id() @default(uuid()) @db.UniqueIdentifier()
  requirementId   String          @db.UniqueIdentifier()
  requirement     Requirement     @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId      String          @db.UniqueIdentifier()
  requestCategory RequestCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive        Boolean         @default(true)

  @@unique([categoryId, requirementId, tenantId])
  @@index([requirementId], name: "idx_category_requirement_id")
  @@index([categoryId], name: "idx_category_category_id")
}

/// Represents a type of a requirement.
model RequirementType {
  id           String        @id() @default(uuid()) @db.UniqueIdentifier()
  name         String        @db.VarChar(100)
  description  String?       @db.VarChar(255)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt()
  deletedAt    DateTime?
  createdBy    String?       @db.VarChar(50)
  updatedBy    String?       @db.VarChar(50)
  tenantId     String        @db.UniqueIdentifier()
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirements Requirement[]

  @@unique([name, tenantId])
  @@index([name], name: "idx_requirement_type_name")
}

/// Represents a hierarchy for assignments.
model AssignmentHierarchy {
