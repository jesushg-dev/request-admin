/// Represents a hierarchy for assignations.
model AssignationHierarchy {
  id          String                      @id() @default(uuid()) @db.UniqueIdentifier()
  name        String                      @db.VarChar(100)
  description String?                     @db.VarChar(255)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime?                   @updatedAt()
  deletedAt   DateTime?
  createdBy   String?                     @db.VarChar(50)
  modifiedBy  String?                     @db.VarChar(50)
  tenantId    String                      @db.UniqueIdentifier()
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels      AssignationHierarchyLevel[]
  categories  AssignationCategory[]

  @@index([name], name: "idx_assignation_hierarchy_name")
}

/// Represents a level within an assignation hierarchy.
model AssignationHierarchyLevel {
  id          String                @id() @default(uuid()) @db.UniqueIdentifier()
  name        String                @db.VarChar(100)
  description String?               @db.VarChar(255)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime?             @updatedAt()
  deletedAt   DateTime?
  createdBy   String?               @db.VarChar(50)
  modifiedBy  String?               @db.VarChar(50)
  tenantId    String                @db.UniqueIdentifier()
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchyId String                @db.UniqueIdentifier()
  hierarchy   AssignationHierarchy  @relation(fields: [hierarchyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories  AssignationCategory[]
  position    Int

  @@unique([position, hierarchyId])
  @@index([hierarchyId], name: "idx_assignation_hierarchy_level_hierarchy_id")
}

/// Represents an assignation category, linked to specific rules and an area.
model AssignationCategory {
  id                 String                    @id() @default(uuid()) @db.UniqueIdentifier()
  name               String                    @db.VarChar(100)
  description        String?                   @db.VarChar(255)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime?                 @updatedAt()
  deletedAt          DateTime?
  createdBy          String?                   @db.VarChar(50)
  modifiedBy         String?                   @db.VarChar(50)
  tenantId           String                    @db.UniqueIdentifier()
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentCategoryId   String?                   @db.UniqueIdentifier()
  parentCategory     AssignationCategory?      @relation("ParentAssignationCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories      AssignationCategory[]     @relation("ParentAssignationCategory")
  hierarchyLevelId   String                    @db.UniqueIdentifier()
  hierarchyLevel     AssignationHierarchyLevel @relation(fields: [hierarchyLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchyId        String                    @db.UniqueIdentifier()
  hierarchy          AssignationHierarchy      @relation(fields: [hierarchyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  areaId             String                    @db.UniqueIdentifier()
  area               Area                      @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignmentRequests Request[]                 @relation("AssignmentCategory")

  @@index([name], name: "idx_assignation_category_name")
  @@index([hierarchyId], name: "idx_assignation_category_hierarchy_id")
  @@index([areaId], name: "idx_assignation_category_area_id")
}

model Form {
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt()
  deletedAt       DateTime?
  createdBy       String?          @db.VarChar(50)
  modifiedBy      String?          @db.VarChar(50)
  tenantId        String           @db.UniqueIdentifier()
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String           @id() @default(uuid()) @db.UniqueIdentifier()
  userId          String           @db.UniqueIdentifier()
  name            String
  description     String           @default("")
  content         String           @default("[]") @db.NVarChar(Max)
  published       Boolean          @default(false)
  visits          Int              @default(0)
  submissions     Int              @default(0)
  shareURL        String           @unique() @default(uuid())
  categoryForms   CategoryForm[]
  formSubmissions FormSubmission[]

  @@unique([name, userId])
}

model CategoryForm {
  createdAt         DateTime        @default(now())
  updatedAt         DateTime?       @updatedAt()
  deletedAt         DateTime?
  createdBy         String?         @db.VarChar(50)
  modifiedBy        String?         @db.VarChar(50)
  tenantId          String          @db.UniqueIdentifier()
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String          @id() @default(uuid()) @db.UniqueIdentifier()
  categoryId        String          @db.UniqueIdentifier()
  formId            String          @db.UniqueIdentifier()
  requestCategories RequestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  form              Form            @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, formId])
}

model FormSubmission {
  createdAt  DateTime            @default(now())
  updatedAt  DateTime?           @updatedAt()
  deletedAt  DateTime?
  createdBy  String?             @db.VarChar(50)
  modifiedBy String?             @db.VarChar(50)
  tenantId   String              @db.UniqueIdentifier()
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id         String              @id() @default(uuid()) @db.UniqueIdentifier()
  formId     String              @db.UniqueIdentifier()
  content    String
  keys       FormSubmissionKey[]
  form       Form                @relation(fields: [formId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId  String?             @db.UniqueIdentifier()
  request    Request?            @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([formId])
}

model FormSubmissionKey {
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt()
  deletedAt    DateTime?
  createdBy    String?        @db.VarChar(50)
  modifiedBy   String?        @db.VarChar(50)
  tenantId     String         @db.UniqueIdentifier()
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String         @id() @default(uuid()) @db.UniqueIdentifier()
  submissionId String         @db.UniqueIdentifier()
  key          String         @db.VarChar(255)
  value        String         @db.VarChar(255)
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([key, value])
}

/// Represents a hierarchy for requests.
model RequestHierarchy {
  id          String                  @id() @default(uuid()) @db.UniqueIdentifier()
  name        String                  @db.VarChar(100)
  description String?                 @db.VarChar(255)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime?               @updatedAt()
  deletedAt   DateTime?
  createdBy   String?                 @db.VarChar(50)
  modifiedBy  String?                 @db.VarChar(50)
  tenantId    String                  @db.UniqueIdentifier()
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels      RequestHierarchyLevel[]
  categories  RequestCategory[]

  @@index([name], name: "idx_request_hierarchy_name")
}

/// Represents a level within a request hierarchy.
model RequestHierarchyLevel {
  id          String            @id() @default(uuid()) @db.UniqueIdentifier()
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(255)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?         @updatedAt()
  deletedAt   DateTime?
  createdBy   String?           @db.VarChar(50)
  modifiedBy  String?           @db.VarChar(50)
  tenantId    String            @db.UniqueIdentifier()
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchyId String            @db.UniqueIdentifier()
  hierarchy   RequestHierarchy  @relation(fields: [hierarchyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories  RequestCategory[]
  position    Int

  @@unique([position, hierarchyId])
  @@index([hierarchyId], name: "idx_request_hierarchy_level_hierarchy_id")
}

/// Represents a request category, with SLA and required documents.
model RequestCategory {
  id                         String                       @id() @default(uuid()) @db.UniqueIdentifier()
  name                       String                       @db.VarChar(100)
  description                String?                      @db.VarChar(255)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime?                    @updatedAt()
  deletedAt                  DateTime?
  createdBy                  String?                      @db.VarChar(50)
  modifiedBy                 String?                      @db.VarChar(50)
  tenantId                   String                       @db.UniqueIdentifier()
  tenant                     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentCategoryId           String?                      @db.UniqueIdentifier()
  parentCategory             RequestCategory?             @relation("ParentRequestCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories              RequestCategory[]            @relation("ParentRequestCategory")
  hierarchyLevelId           String                       @db.UniqueIdentifier()
  hierarchyLevel             RequestHierarchyLevel        @relation(fields: [hierarchyLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchyId                String                       @db.UniqueIdentifier()
  hierarchy                  RequestHierarchy             @relation(fields: [hierarchyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sla                        SLA?
  guideDocuments             GuideDocument[]
  isEligibleForNewClients    Boolean                      @default(true)
  categoryForms              CategoryForm[]
  requestCategoryRequirement RequestCategoryRequirement[]
  requests                   Request[]                    @relation("RequestCategory")

  @@index([name], name: "idx_request_category_name")
  @@index([hierarchyId], name: "idx_request_category_hierarchy_id")
}

/// SLA (Service Level Agreement) model.
model SLA {
  createdAt         DateTime         @default(now())
  updatedAt         DateTime?        @updatedAt()
  deletedAt         DateTime?
  createdBy         String?          @db.VarChar(50)
  modifiedBy        String?          @db.VarChar(50)
  tenantId          String           @db.UniqueIdentifier()
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String           @id() @default(uuid()) @db.UniqueIdentifier()
  resolutionTime    Int
  escalationTime    Int?
  requestCategoryId String?          @unique() @db.UniqueIdentifier()
  requestCategory   RequestCategory? @relation(fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestCategoryId], name: "idx_sla_request_category_id")
}

/// Represents a guide document used to resolve a request.
model GuideDocument {
  createdAt         DateTime        @default(now())
  updatedAt         DateTime?       @updatedAt()
  deletedAt         DateTime?
  createdBy         String?         @db.VarChar(50)
  modifiedBy        String?         @db.VarChar(50)
  tenantId          String          @db.UniqueIdentifier()
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                String          @id() @default(uuid()) @db.UniqueIdentifier()
  name              String          @db.VarChar(100)
  description       String?         @db.VarChar(255)
  url               String?         @db.VarChar(500)
  status            Int
  expirationDate    DateTime?
  requestCategoryId String          @db.UniqueIdentifier()
  requestCategory   RequestCategory @relation(fields: [requestCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestCategoryId], name: "idx_guide_document_request_category_id")
}

/// Links a requirement to a specific category.
model RequestCategoryRequirement {
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?       @updatedAt()
  deletedAt       DateTime?
  createdBy       String?         @db.VarChar(50)
  modifiedBy      String?         @db.VarChar(50)
  tenantId        String          @db.UniqueIdentifier()
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String          @id() @default(uuid()) @db.UniqueIdentifier()
  requirementId   String          @db.UniqueIdentifier()
  requirement     Requirement     @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId      String          @db.UniqueIdentifier()
  requestCategory RequestCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requirementId], name: "idx_category_requirement_id")
  @@index([categoryId], name: "idx_category_category_id")
}

/// Represents a specific requirement for a request/assignment category.
model Requirement {
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime?                       @updatedAt()
  deletedAt                     DateTime?
  createdBy                     String?                         @db.VarChar(50)
  modifiedBy                    String?                         @db.VarChar(50)
  tenantId                      String                          @db.UniqueIdentifier()
  tenant                        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                            String                          @id() @default(uuid()) @db.UniqueIdentifier()
  name                          String                          @unique() @db.VarChar(200)
  description                   String                          @db.VarChar(500)
  isRequiredOnlyForNewClients   Boolean                         @default(false)
  requirementComplianceTracking RequirementComplianceTracking[]
  requestCategoryRequirement    RequestCategoryRequirement[]
  requirementTypeId             String                          @db.UniqueIdentifier()
  requirementType               RequirementType                 @relation(fields: [requirementTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([name], name: "idx_requirement_name")
}

/// Represents a type of a requirement.
model RequirementType {
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt()
  deletedAt    DateTime?
  createdBy    String?       @db.VarChar(50)
  modifiedBy   String?       @db.VarChar(50)
  tenantId     String        @db.UniqueIdentifier()
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String        @id() @default(uuid()) @db.UniqueIdentifier()
  name         String        @unique() @db.VarChar(100)
  description  String        @db.VarChar(255)
  requirements Requirement[]

  @@index([name], name: "idx_requirement_type_name")
}

model Workspace {
  tenantId     String         @db.UniqueIdentifier()
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           String         @id() @default(uuid()) @db.UniqueIdentifier()
  name         String
  joinCode     String
  userId       String         @db.UniqueIdentifier()
  user         User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members      Member[]
  channels     Channel[]
  messages     Message[]
  reactions    Reaction[]
  conversation Conversation[]

  @@index([userId])
}

model Member {
  tenantId                 String         @db.UniqueIdentifier()
  tenant                   Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                       String         @id() @default(uuid()) @db.UniqueIdentifier()
  userId                   String         @db.UniqueIdentifier()
  workspaceId              String         @db.UniqueIdentifier()
  user                     User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace                Workspace      @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions                Reaction[]
  messages                 Message[]
  conversationsAsMemberOne Conversation[] @relation("MemberOne")
  conversationsAsMemberTwo Conversation[] @relation("MemberTwo")

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model Channel {
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  name        String
  workspaceId String    @db.UniqueIdentifier()
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction)
  messages    Message[]

  @@index([workspaceId])
}

model Conversation {
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  workspaceId String    @db.UniqueIdentifier()
  memberOneId String    @db.UniqueIdentifier()
  memberTwoId String    @db.UniqueIdentifier()
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberOne   Member    @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberTwo   Member    @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages    Message[]

  @@index([workspaceId])
}

model Message {
  tenantId        String        @db.UniqueIdentifier()
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id              String        @id() @default(uuid()) @db.UniqueIdentifier()
  body            String
  imageId         String?       @db.UniqueIdentifier()
  updatedAt       DateTime?     @updatedAt()
  memberId        String        @db.UniqueIdentifier()
  workspaceId     String        @db.UniqueIdentifier()
  channelId       String?       @db.UniqueIdentifier()
  parentMessageId String?       @db.UniqueIdentifier()
  conversationId  String?       @db.UniqueIdentifier()
  member          Member        @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel         Channel?      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  parentMessage   Message?      @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]     @relation("ParentMessage")
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reactions       Reaction[]

  @@index([workspaceId])
  @@index([memberId])
  @@index([channelId])
  @@index([parentMessageId])
  @@index([conversationId])
  @@index([channelId, parentMessageId, conversationId])
}

model Reaction {
  tenantId    String    @db.UniqueIdentifier()
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String    @id() @default(uuid()) @db.UniqueIdentifier()
  value       String
  workspaceId String    @db.UniqueIdentifier()
  messageId   String    @db.UniqueIdentifier()
  memberId    String    @db.UniqueIdentifier()
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId])
  @@index([messageId])
  @@index([memberId])
}
