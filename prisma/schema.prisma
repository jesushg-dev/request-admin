  parentCategoryId        String?               @map("parent_id") @db.UniqueIdentifier()
  parentCategory          Category?             @relation("ParentCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories           Category[]            @relation("ParentCategory")
  hierarchyLevelId        String                @db.UniqueIdentifier()
  hierarchyLevel          HierarchyLevel        @relation(fields: [hierarchyLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
