{
  "name": "request-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 zenstack generate && prisma generate && next build",
    "build:local": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build:test": "next lint && tsc --noEmit && next build && next start",
    "postinstall": "prisma generate",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx ts-node --esm prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prettierrc": "prettier --write .",
    "generate": "npx zenstack generate && npx prisma db push && prettier --write \"src/services/api/**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "test": "jest",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open",
    "type": "npx tsc --noEmit --pretty"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "importOrder": [
      "^(react/(.*)$)|^(react$)",
      "^(next/(.*)$)|^(next$)",
      "<THIRD_PARTY_MODULES>",
      "",
      "^types$",
      "^@/types/(.*)$",
      "^@/config/(.*)$",
      "^@/lib/(.*)$",
      "^@/hooks/(.*)$",
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/styles/(.*)$",
      "^@/app/(.*)$",
      "",
      "^[./]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "jsx",
      "decorators-legacy"
    ],
    "plugins": [
      "prettier-plugin-tailwindcss",
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "printWidth": 200,
    "tailwindStylesheet": "./app/globals.css"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
