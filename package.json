{
  "name": "request-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-schema.js vercel",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 zenstack generate && prisma generate && next build",
    "prebuild:local": "node scripts/copy-schema.js local",
    "build:local": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "predev": "node scripts/copy-schema.js local",
    "build:test": "eslint . && tsc --noEmit && next build && next start",
    "postinstall": "prisma generate",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:requests": "tsx prisma/seed-requests.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prettierrc": "prettier --write .",
    "pregenerate": "node scripts/copy-schema.js local",
    "generate": "npx zenstack generate && npx prisma db push && prettier --write \"src/services/api/**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "test": "jest",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headed": "cypress run --headed --browser chrome",
    "cypress:run:spec": "cypress run --spec",
    "cypress:open:chrome": "cypress open --browser chrome",
    "type": "npx tsc --noEmit --pretty",
    "i18n:check": "i18n-check --locales messages --source en --format i18next",
    "i18n:check:missing": "i18n-check --locales messages --source en --format i18next --only missingKeys",
    "i18n:check:invalid": "i18n-check --locales messages --source en --format i18next --only invalidKeys",
    "i18n:check:unused": "i18n-check --locales messages --source en --format i18next --only unused --unused src",
    "i18n:check:undefined": "i18n-check --locales messages --source en --format i18next --only undefined --unused src"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "importOrder": [
      "^(react/(.*)$)|^(react$)",
      "^(next/(.*)$)|^(next$)",
      "<THIRD_PARTY_MODULES>",
      "",
      "^types$",
      "^@/types/(.*)$",
      "^@/config/(.*)$",
      "^@/lib/(.*)$",
      "^@/hooks/(.*)$",
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/styles/(.*)$",
      "^@/app/(.*)$",
      "",
      "^[./]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "jsx",
      "decorators-legacy"
    ],
    "plugins": [
      "prettier-plugin-tailwindcss",
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "printWidth": 200,
    "tailwindStylesheet": "./app/globals.css"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
